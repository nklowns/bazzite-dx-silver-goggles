cosign.key
_build_*
_build-*/**
# Ignore all RPMs by default (build artifacts)
*.rpm
output/
*.qcow2
*.raw
*.iso
# Old build system artifacts (clean up)
.claude/

# CI stages the signed kmod here; it is consumed by the build and must not be
# committed by a local `git add -A` after a CI-like run.
files/system/usr/share/silver-goggles/kmod-staging/
*.ko
