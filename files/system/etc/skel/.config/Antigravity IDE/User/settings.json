{
  "editor.fontFamily": "'FiraCode Nerd Font', 'JetBrainsMono Nerd Font', 'Hack Nerd Font', 'Monaspace Krypton', Consolas, 'Courier New', monospace",
  "editor.fontLigatures": "'calt', 'liga', 'dlig', 'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08', 'ss09'",

  "update.mode": "none",

  "terminal.integrated.env.linux": {
    "EDITOR": "antigravity-ide --wait",
    "VISUAL": "antigravity-ide --wait"
  },

  "terminal.integrated.defaultProfile.linux": "fish",
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "bash"
    },
    "zsh": {
      "path": "zsh"
    },
    "fish": {
      "path": "fish"
    },
    "tmux": {
      "path": "tmux",
      "args": ["new-session", "-A", "-s", "${workspaceFolderBasename}"],
      "icon": "terminal-tmux",
    },
  }
}
