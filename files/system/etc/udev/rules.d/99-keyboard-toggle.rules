# 1. Permitir que o grupo 'input' escreva no arquivo de inibição do teclado integrado (toggling sem senha)
# Suporta 'add' (no boot) e 'change' (ao suspender/retomar ou rodar udevadm trigger)
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="input*", ATTRS{name}=="AT Translated Set 2 keyboard", RUN+="/usr/bin/sh -c 'chgrp input %S%p/inhibited && chmod 664 %S%p/inhibited'"
