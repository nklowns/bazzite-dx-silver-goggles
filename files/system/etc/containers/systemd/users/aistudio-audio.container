# AI Studio — Local Voice & Audio Studio (VoiceStudio / OmniVoice).
# Powered by VoiceStudio v0.5.2 (16 TTS, 11 ASR, Demucs stems, dubbing, audiobooks).
#
# MEMORY & HARDWARE ARCHITECTURE (RTX 3060 6GB + 64GB DDR5)
# ---------------------------------------------------------
# - Hardware accelerated via NVIDIA CUDA on RTX 3060 Mobile GPU (CDI).
# - Smart memory offloading to 64GB DDR5 system RAM.
# - Provides standard OpenAI-compatible endpoints:
#   - /v1/audio/speech (TTS)
#   - /v1/audio/transcriptions (ASR Whisper)
#
# NETWORK & TAILSCALE-FIRST
# -------------------------
# - Internal network alias: http://aistudio-audio:3900, http://audio:3900, http://voicestudio:3900
# - Published on host loopback: 127.0.0.1:61386
# - Exposed securely over the tailnet via `ujust remote-audio-setup`

[Unit]
Description=AI Studio — Audio Studio (VoiceStudio v0.5.2 & OpenAI API, Port 61386)
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
Image=ghcr.io/debpalash/omnivoice-studio:latest@sha256:efd760dd931df55852210058a532cf333544b3f52460490a7f9b048bd57895f7
ContainerName=aistudio_audio
Network=project-nomad_default.network
NetworkAlias=aistudio-audio
NetworkAlias=audio
NetworkAlias=voicestudio
NetworkAlias=tts
NetworkAlias=voice
NetworkAlias=whisper
PublishPort=127.0.0.1:61386:3900

AddDevice=nvidia.com/gpu=all
Environment=NVIDIA_VISIBLE_DEVICES=all
Environment=NVIDIA_DRIVER_CAPABILITIES=compute,utility
Environment=OMNIVOICE_BIND_HOST=0.0.0.0
Environment=OMNIVOICE_SERVER_MODE=1
Environment=OMNIVOICE_DATA_DIR=/app/omnivoice_data
Environment=HOME=/app/omnivoice_data
Environment=OMNIVOICE_TORCH_COMPILE=0
Environment=HF_HOME=/app/omnivoice_data/huggingface
Environment=OMNIVOICE_CACHE_DIR=/app/omnivoice_data/cache
Environment=XDG_CACHE_HOME=/app/omnivoice_data/cache
Environment=TRITON_CACHE_DIR=/app/omnivoice_data/triton
Environment=TORCH_COMPILE_DISABLE=1
Environment=OMNIVOICE_ASR_BACKEND=pytorch-whisper
Environment=PYTHONPATH=/app/omnivoice_data/site-packages:/app/backend
Environment=PYTHONUNBUFFERED=1

Volume=/var/srv/audio/data:/app/omnivoice_data:Z
Volume=%h/Music/AI_Studio:/app/omnivoice_data/output:Z
UserNS=keep-id

[Service]
Restart=on-failure
TimeoutStartSec=300
LimitMEMLOCK=infinity
LimitNOFILE=65535

# [Install] is omitted on purpose: respect Boot Impact Policy.
# Start on-demand via `ujust audio-up` or `ujust tts-up`.
