[Unit]
Description=Project NOMAD — Redis (job queue)

[Container]
Image=docker.io/library/redis@sha256:077ba791400f390cb96d9d419d90259d5e72e697fca7abc3bbde6d83285d7346
ContainerName=nomad_redis
Network=project-nomad_default.network
# REDIS_HOST=redis in the admin — same Compose-alias gap as nomad-mysql.container.
NetworkAlias=redis

# Sibling of storage/, same reasoning as nomad-mysql.container.
Volume=/var/srv/nomad/redis:/data

HealthCmd=redis-cli ping
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
Notify=healthy

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
