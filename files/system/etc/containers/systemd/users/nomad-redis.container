[Unit]
Description=Project NOMAD — Redis (job queue)
# Rate limiting to prevent unthrottled restart thrashing on failure
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
Image=docker.io/library/redis@sha256:c8deb6d5d6d30f67aa6d18075b2336f65d783a80415381500bfc7a5ea8266070
ContainerName=nomad_redis
Network=project-nomad_default.network
# REDIS_HOST=redis in the admin — same Compose-alias gap as nomad-mysql.container.
NetworkAlias=redis

# Sibling of storage/, same reasoning as nomad-mysql.container.
Volume=/var/srv/nomad/redis:/data

HealthCmd=redis-cli ping
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
Notify=healthy

[Service]
Restart=on-failure

# [Install] is omitted on purpose: podman-user-generator automatically links any Quadlet unit
# containing [Install] WantedBy=default.target into /run/user/1000/systemd/generator/default.target.wants/,
# auto-starting the stack at boot under user lingering and violating the Boot Impact Policy.
# The stack is strictly opt-in and started on demand via `ujust nomad-up`.
