[Unit]
Description=RustDesk Self-Hosted Relay Server (hbbr)
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
Image=docker.io/rustdesk/rustdesk-server:latest@sha256:8ecdab65deb7c84652a626380e31d11a8f1fbafd97916d57f95c20628f943c00
ContainerName=rustdesk_hbbr
Network=host
Exec=hbbr
Volume=/var/srv/rustdesk:/root:Z

# Same accepted risk as rustdesk-hbbs.container: hbbr always binds a WebSocket port (21119)
# alongside its relay port (21117), reachable on the tailnet, no reverse proxy in front. See
# that file's comment for the full reasoning.

[Service]
Restart=on-failure
