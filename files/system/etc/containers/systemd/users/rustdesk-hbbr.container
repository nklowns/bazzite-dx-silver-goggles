[Unit]
Description=RustDesk Self-Hosted Relay Server (hbbr)
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
Image=docker.io/rustdesk/rustdesk-server:latest@sha256:8ecdab65deb7c84652a626380e31d11a8f1fbafd97916d57f95c20628f943c00
ContainerName=rustdesk_hbbr
Network=host
Exec=hbbr
Volume=/var/srv/rustdesk:/root:Z

[Service]
Restart=on-failure
