# AI Studio — Local Speech-to-Text (STT / Faster-Whisper) Microservice.
# Real-time microphone and audio file transcription running 100% on CPU.
#
# NETWORK & TAILSCALE-FIRST
# -------------------------
# - Internal network alias: http://whisper:5000 and http://stt:5000
# - Published on host loopback: 127.0.0.1:61388
# - Exposed securely over the tailnet via `ujust remote-audio-setup`

[Unit]
Description=AI Studio — Faster-Whisper Speech-to-Text (Port 61388)
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
Image=docker.io/library/python:3.12-slim
ContainerName=ai_voice_stt
Network=project-nomad_default.network
NetworkAlias=whisper
NetworkAlias=stt
PublishPort=127.0.0.1:61388:5000


Volume=/var/srv/audio/app:/app:Z
Volume=/var/srv/audio/stt/models:/models:Z
Volume=/var/srv/audio/output:/output:Z

Exec=python3 /app/stt_server.py

[Service]
Restart=on-failure
TimeoutStartSec=300

# [Install] is omitted on purpose: respect Boot Impact Policy.
# Start on-demand via `ujust whisper-up`.
