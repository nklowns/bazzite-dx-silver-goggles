# ComfyUI Image & Video Diffusion Studio (AI Studio).
# Independent DX service decoupled from Project NOMAD.
#
# MEMORY ARCHITECTURE FOR 6GB VRAM + 64GB DDR5
# ---------------------------------------------
# - --enable-dynamic-vram: dynamically swaps memory blocks to prevent OOM
# - --cache-ram 16 48: pins model weights in the 64GB DDR5 system RAM
# - --cpu-text-encoder: offloads the heavy T5 text encoder to system RAM
#
# PUBLISHED ON TAILSCALE AT :61384
# --------------------------------
# Bound to 127.0.0.1:61384 and exposed securely over the tailnet via `ujust remote-comfyui-setup`.

[Unit]
Description=AI Studio — ComfyUI (Image & Video Diffusion Studio)
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
Image=docker.io/yanwk/comfyui-boot:cu124-slim
ContainerName=ai_comfyui
Network=project-nomad_default.network
NetworkAlias=comfyui
PublishPort=127.0.0.1:61384:8188

AddDevice=nvidia.com/gpu=all
Environment=NVIDIA_VISIBLE_DEVICES=all
Environment=NVIDIA_DRIVER_CAPABILITIES=compute,utility

Volume=/var/srv/comfyui/ComfyUI:/root/ComfyUI:Z
Volume=/var/srv/comfyui/user-scripts:/root/user-scripts:Z

Environment=CLI_ARGS=--fast

[Service]
Restart=on-failure
TimeoutStartSec=600

# [Install] is omitted on purpose: respect Boot Impact Policy for gaming sessions.
# Start on-demand via `ujust comfyui-up`.
