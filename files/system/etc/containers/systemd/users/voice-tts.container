# AI Studio — Local Multi-Language TTS & Voice Cloning Microservice.
# Intelligent Hybrid service (GPU accelerated with automatic CPU fallback).
#
# MEMORY & HARDWARE ARCHITECTURE
# ------------------------------
# - Uses CUDA when free VRAM >= 1.2 GB for sub-second synthesis
# - Auto-fallbacks to CPU/DDR5 when ComfyUI or Ollama is active (0 MB VRAM)
# - Multi-language synthesis: Piper PT-BR, EN-US, ES-ES + OpenVoice V2 Tone Converter
#
# NETWORK & TAILSCALE-FIRST
# -------------------------
# - Internal network alias: http://tts:5000 and http://voice:5000
# - Published on host loopback: 127.0.0.1:61386
# - Exposed securely over the tailnet via `ujust remote-audio-setup`

[Unit]
Description=AI Studio — Multi-Language TTS & Voice Cloning (Port 61386)
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
Image=docker.io/library/python:3.12-slim@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a
ContainerName=ai_voice_tts
Network=project-nomad_default.network
NetworkAlias=tts
NetworkAlias=voice
PublishPort=127.0.0.1:61386:5000

AddDevice=nvidia.com/gpu=all
Environment=NVIDIA_VISIBLE_DEVICES=all
Environment=NVIDIA_DRIVER_CAPABILITIES=compute,utility

Volume=/var/srv/audio/app:/app:Z
Volume=/var/srv/audio/tts/models:/models:Z
Volume=/var/srv/audio/voices:/voices:Z
Volume=/var/srv/audio/output:/output:Z

Exec=python3 /app/tts_server.py

[Service]
Restart=on-failure
TimeoutStartSec=300

# [Install] is omitted on purpose: respect Boot Impact Policy.
# Start on-demand via `ujust tts-up`.
