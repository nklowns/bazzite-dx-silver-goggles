[Unit]
Description=Project NOMAD — MySQL
# Rate limiting to prevent unthrottled restart thrashing on failure
StartLimitIntervalSec=300
StartLimitBurst=5
# The admin runs Adonis migrations on boot and dies if the database is not accepting
# connections yet, so this must be genuinely ready, not merely started. Notify=healthy
# below is what makes `Requires=`/`After=` in nomad-admin.container mean "healthy"
# rather than "process spawned" — it is the Quadlet translation of Compose's
# `depends_on: { mysql: { condition: service_healthy } }`.

[Container]
Image=docker.io/library/mysql:26.7@sha256:973c5e8e4d2f12ecc3da9ca9d8d4189b6a7e3d17584c66fca6dae6993c0417ed
ContainerName=nomad_mysql
Network=project-nomad_default.network
# The admin connects to DB_HOST=mysql. Under Compose that name came free from the service
# key; Quadlet only publishes ContainerName (nomad_mysql), so the short name has to be
# declared or the admin fails DNS resolution and never completes its migrations.
NetworkAlias=mysql

# Sibling of storage/, never inside it. _resolveHostStorageRoot() (docker_service.ts:505)
# resolves the admin's /app/storage bind and rewrites every child app's bind underneath it,
# so nesting the database in there would make the UI's disk-usage and content browser count
# innodb files as offline content — and put them in reach of a content reset.
Volume=/var/srv/nomad/mysql:/var/lib/mysql

# No :z here, deliberately. /var/srv/nomad is labelled container_file_t declaratively (see
# the SELinux provisioning in files/system/usr/libexec/bazzite-dx-groups). That single
# mechanism is required anyway, because the binds the admin generates for child apps carry
# no :z and cannot be given one — adding :z here too would mean two writers of the same
# label with no benefit. Measured: an unlabelled bind is denied outright, a container_file_t
# one is writable by a plain container with no :z at all.
EnvironmentFile=/var/srv/nomad/.env
Environment=MYSQL_DATABASE=nomad
Environment=MYSQL_USER=nomad_user

HealthCmd=mysqladmin ping -h localhost
HealthInterval=30s
HealthTimeout=10s
HealthRetries=10
Notify=healthy

[Service]
Restart=on-failure
# First start initialises the data directory, which is far past systemd's 90s default.
TimeoutStartSec=300

# [Install] is omitted on purpose: podman-user-generator automatically links any Quadlet unit
# containing [Install] WantedBy=default.target into /run/user/1000/systemd/generator/default.target.wants/,
# auto-starting the stack at boot under user lingering and violating the Boot Impact Policy.
# The stack is strictly opt-in and started on demand via `ujust nomad-up`.
