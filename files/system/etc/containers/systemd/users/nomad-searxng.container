# SearXNG Metasearch Engine — Agent Mesh & NOMAD search provider
#
# Part of the Agent Mesh. Operates autonomously on the shared OCI network.
# Connects to nomad-redis for caching and publishes strictly to loopback (127.0.0.1:61387); remote exposure via `ujust remote-searxng-setup`.
#
# [Install] is omitted on purpose: podman-user-generator links any unit with [Install] into
# default.target.wants/, which under user lingering starts at boot and violates the Boot Impact Policy.
# Started on demand via `ujust searxng-up`.

[Unit]
Description=SearXNG Metasearch Engine (Agent Mesh)
StartLimitIntervalSec=300
StartLimitBurst=5
Wants=nomad-redis.service nomad-tor.service nomad-trawl.service
After=nomad-redis.service nomad-tor.service nomad-trawl.service

[Container]
Image=docker.io/searxng/searxng:latest@sha256:55e1fa15a63ff04e79e213e6aa2837549877b0c6d60757cdb633ae9111cb5fea
ContainerName=nomad_searxng
Network=project-nomad_default.network
NetworkAlias=searxng

# Loopback binding per workstation security policy
PublishPort=127.0.0.1:61387:8080

Volume=/var/srv/searxng:/etc/searxng:Z

Environment=SEARXNG_BASE_URL=http://localhost:61387
Environment=CURL_CA_BUNDLE=/etc/searxng/ca-bundle.crt
Environment=SSL_CERT_FILE=/etc/searxng/ca-bundle.crt

HealthCmd=wget -q --spider http://localhost:8080/healthz || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
Notify=healthy

[Service]
Restart=on-failure
TimeoutStartSec=300
