# AI Studio — Local AI Music Generation & Stem Separation Microservice.
# Intelligent Hybrid service (GPU accelerated with automatic CPU fallback).
#
# NETWORK & TAILSCALE-FIRST
# -------------------------
# - Internal network alias: http://music:5000
# - Published on host loopback: 127.0.0.1:61387
# - Exposed securely over the tailnet via `ujust remote-audio-setup`

[Unit]
Description=AI Studio — Music Generation & Stem Separation (Port 61387)
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
Image=docker.io/library/python:3.14-slim@sha256:ce40764625a4ff50df3548277632e7f96c4e77fe75fa848aae9885476e7df5a4
ContainerName=ai_audio_music
Network=project-nomad_default.network
NetworkAlias=music
PublishPort=127.0.0.1:61387:5000

AddDevice=nvidia.com/gpu=all
Environment=NVIDIA_VISIBLE_DEVICES=all
Environment=NVIDIA_DRIVER_CAPABILITIES=compute,utility

Volume=/var/srv/audio/app:/app:Z
Volume=/var/srv/audio/music/models:/models:Z
Volume=/var/srv/audio/output:/output:Z

Exec=python3 /app/music_server.py

[Service]
Restart=on-failure
TimeoutStartSec=300

# [Install] is omitted on purpose: respect Boot Impact Policy.
# Start on-demand via `ujust music-up`.
