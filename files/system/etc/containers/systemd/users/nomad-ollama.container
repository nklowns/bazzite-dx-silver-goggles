# Ollama, deliberately OUTSIDE the Command Center's control.
#
# WHY THIS IS NOT A SUPPLY DEPOT APP
# ----------------------------------
# The Command Center can install Ollama itself, and on this image that path is a trap. It
# detects NVIDIA by looking for an 'nvidia' key in the container engine's Runtimes map and
# then creates the container with HostConfig.DeviceRequests (docker_service.ts:710-730).
# Podman's docker-compat API accepts that payload and drops it on the floor — measured:
#
#     POST /v1.41/containers/create  HostConfig.DeviceRequests[{Driver:nvidia,Count:-1}]
#       -> 201 Created, Warnings: [], start 204
#       -> container logs: NO_NVIDIA_DEVICES
#
# while docker, same payload and same host, injects the devices. Nothing errors, nothing warns,
# and the UI cheerfully reports "NVIDIA container runtime detected". The user would get a
# CPU-only assistant on a machine with an RTX 3060 and no way to tell from inside the product.
#
# The one podman-side workaround that did work — a global `[containers] devices=` default in
# containers.conf — hands a GPU to every container the engine ever starts, mysql and redis
# included. Not a trade worth making to keep a button working.
#
# So the GPU workload lives here instead, with a real CDI device, and NOMAD is pointed at it
# as an external endpoint. That path is supported upstream: OllamaService._initialize() checks
# KVStore key `ai.remoteOllamaUrl` first and only falls back to the Supply Depot container when
# it is unset (admin/app/services/ollama_service.ts:63-75). See README for the exact value.

[Unit]
Description=Project NOMAD — Ollama (GPU inference)
# Rate limiting to prevent unthrottled restart thrashing on failure
StartLimitIntervalSec=300
StartLimitBurst=5
# Shares the stack network so the Command Center can reach it by alias, but is NOT required by
# nomad-admin: the Command Center is perfectly usable for offline content with no AI at all,
# and a 6 GB VRAM workload should never be dragged up as a side effect of opening Wikipedia.

[Container]
Image=docker.io/ollama/ollama@sha256:4dea9fb511947e24a84237bb636b0203abcb2ff0d3fbc7b4ff865deb91362131

# NOT `nomad_ollama`, which is what this was called first and is the single most important
# line in the file. admin/constants/service_names.ts declares:
#
#     SERVICE_NAMES = { OLLAMA: 'nomad_ollama', … }
#
# The Command Center holds the container socket and treats any container with one of those
# names as a service it owns — free to stop, remove and recreate. Naming this container
# nomad_ollama handed it straight back to the orchestrator that this whole arrangement exists
# to keep it away from. Observed: the container answered the admin's probes and then vanished
# in the same second, leaving no stop reason in its own journal.
#
# The `gpu` suffix is not decoration; it is what keeps this instance outside NOMAD's registry.
ContainerName=nomad_ollama_gpu
Network=project-nomad_default.network
# The admin is pointed at http://ollama:11434, so the alias is what has to be stable — not the
# container name. Keeping them separate is what lets the name stay out of NOMAD's namespace
# while the endpoint the UI is configured with never changes.
NetworkAlias=ollama

# Native CDI, which is the whole reason this container exists separately. Verified working on
# this host once the three GPU gates were fixed — nvidia-persistenced actually starting, the
# CDI spec being regenerated with it up, and container_use_devices turned on:
#     $ podman run --rm --device nvidia.com/gpu=all alpine sh -c 'ls /dev | grep nvidia'
#     nvidia-modeset  nvidia-uvm  nvidia-uvm-tools  nvidia0  nvidiactl
AddDevice=nvidia.com/gpu=all

# Model weights are tens of GB and are NOT offline "content": kept as a sibling of storage/ so
# the Command Center's disk-usage view and content browser do not count them, and so a content
# reset cannot reach them.
Volume=/var/srv/nomad/ollama:/root/.ollama

# 61382 in the reserved DX range, NOT Ollama's default 11434. That default is exactly the port
# a separately-installed Ollama would already own on a developer workstation — publishing it
# here would make two inference servers fight over one port, with whichever started first
# winning silently.
#
# Loopback, and here it is not a nicety. Ollama has no authentication and no rate limiting:
# anything that can reach the port can run inference, load and delete models, and read what
# is loaded. With tailscale0 in firewalld's `trusted` zone, publishing on all interfaces put
# exactly that on the tailnet. Measured before the change:
#
#     curl http://bazzite.drake-ayu.ts.net:61382/api/tags   -> {"models":[]}
#
# The admin never used this mapping — it reaches Ollama at http://ollama:11434 over the
# container network — so binding loopback costs nothing and closes the hole. Host-side tools
# still work; anything remote should go through `tailscale serve` deliberately.
PublishPort=127.0.0.1:61382:11434

Environment=OLLAMA_HOST=0.0.0.0
# Unload the model 5 minutes after the last request instead of holding VRAM indefinitely. This
# box also plays games on the same RTX 3060, and an idle assistant sitting on several GB of
# VRAM is precisely the background cost the Boot Impact Policy exists to prevent.
Environment=OLLAMA_KEEP_ALIVE=5m

HealthCmd=ollama list
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3

[Service]
Restart=on-failure
# The image is several GB; the systemd default of 90s is not enough for a cold pull.
TimeoutStartSec=900

# [Install] is omitted on purpose: podman-user-generator automatically links any Quadlet unit
# containing [Install] WantedBy=default.target into /run/user/1000/systemd/generator/default.target.wants/,
# auto-starting the stack at boot under user lingering and violating the Boot Impact Policy.
# The stack is strictly opt-in and started on demand via `ujust ollama-up`.
