[Unit]
Description=RustDesk Self-Hosted ID/Signal Server (hbbs)
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
Image=docker.io/rustdesk/rustdesk-server:latest@sha256:8ecdab65deb7c84652a626380e31d11a8f1fbafd97916d57f95c20628f943c00
ContainerName=rustdesk_hbbs
Network=host
Exec=hbbs
Volume=%h/rustdesk-server:/root

[Service]
Restart=on-failure
