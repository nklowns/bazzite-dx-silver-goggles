[Unit]
Description=RustDesk Self-Hosted ID/Signal Server (hbbs)
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
Image=docker.io/rustdesk/rustdesk-server:latest@sha256:8ecdab65deb7c84652a626380e31d11a8f1fbafd97916d57f95c20628f943c00
ContainerName=rustdesk_hbbs
Network=host
Exec=hbbs
Volume=/var/srv/rustdesk:/root:Z

# Accepted risk, not a bug: hbbs always binds its WebSocket port (21118, from
# rendezvous_server.rs) alongside the native-client ports (21115/21116), with no CLI flag to
# disable it independently — `-p` only shifts the whole range together. Verified reachable at
# this host's tailnet address (no web client is used here, and upstream's own docs say to keep
# 21118/21119 closed without one: rustdesk.com/docs/en/self-host/rustdesk-server-oss/install).
# Not fronted by a reverse proxy, so the X-Real-IP/X-Forwarded-For spoofing risk documented there
# applies to anyone already on the tailnet. Accepted because the tailnet is this host's trust
# boundary already (see the tailscale0/trusted-zone note in CLAUDE.md); revisit if that stops
# being true, or if hbbs ever ships a flag to disable the websocket listener.

[Service]
Restart=on-failure
