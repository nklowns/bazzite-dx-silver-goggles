[Unit]
Description=MediaMTX Multi-Camera RTSP/WebRTC Video Router
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
Image=docker.io/bluenviron/mediamtx:latest@sha256:c730bccdbc8739f8f0c13cefe9bea8b61926f599b88fa4d0d229baa91846c7bc
ContainerName=mediamtx_router
Network=host
Volume=/var/srv/mediamtx/mediamtx.yml:/mediamtx.yml:ro,Z

[Service]
Restart=on-failure
