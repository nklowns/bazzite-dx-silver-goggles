[Unit]
Description=MediaMTX Multi-Camera RTSP/WebRTC Video Router
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
Image=docker.io/bluenviron/mediamtx:latest@sha256:5ce2a948eb68df06ce2e13870db8df8e30d516ac4dc40e04bfe8aee3bdf7be40
ContainerName=mediamtx_router
Network=host
Volume=/var/srv/mediamtx/mediamtx.yml:/mediamtx.yml:ro,Z

[Service]
Restart=on-failure
