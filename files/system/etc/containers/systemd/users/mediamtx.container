[Unit]
Description=MediaMTX Multi-Camera RTSP/WebRTC Video Router
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
Image=docker.io/bluenviron/mediamtx:latest@sha256:1b029d11049be75630e9b73bb0d5f47b08a7db4eaee89a80bf8f53bc40e56414
ContainerName=mediamtx_router
Network=host
Volume=%h/.config/mediamtx/mediamtx.yml:/mediamtx.yml:ro

[Service]
Restart=on-failure
