[Unit]
Description=MediaMTX Multi-Camera RTSP/WebRTC Video Router
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
Image=docker.io/bluenviron/mediamtx:latest@sha256:c7540465f868a02652118bea5a0daab12a29ac0f6cb8485abd535939ecddf886
ContainerName=mediamtx_router
Network=host
Volume=/var/srv/mediamtx/mediamtx.yml:/mediamtx.yml:ro,Z

[Service]
Restart=on-failure
