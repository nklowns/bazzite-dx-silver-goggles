# YaCy P2P Search Engine (On-demand local indexer node)
#
# Part of the Agent Mesh. Operates autonomously on the shared OCI network.
# Provides a local P2P DHT crawler and indexer node for deep crawling.
# Publishes strictly to loopback (127.0.0.1:8090); internal alias `yacy:8090`.
#
# [Install] is omitted on purpose per Boot Impact Policy.
# Started on demand via `ujust yacy-up`.

[Unit]
Description=YaCy P2P Search Engine (Agent Mesh Local Node)
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
Image=docker.io/yacy/yacy_search_server:latest@sha256:58f63b879e20ddf55064b01c2d6cb10c459077ef0912976a32e8288e84c9b13c
ContainerName=nomad_yacy
Network=project-nomad_default.network
NetworkAlias=yacy

# Resource bounds per Workstation & Gaming Policy
Memory=2G
Environment=JAVA_OPTS=-Xms256m -Xmx1536m

# Loopback binding per workstation security policy
PublishPort=127.0.0.1:8090:8090

Volume=/var/srv/yacy/DATA:/opt/yacy/DATA:Z

[Service]
Restart=on-failure
TimeoutStartSec=300
