#!/usr/bin/env bash
#
# Author: SharkWipf
#
# Copy this file to /etc/libvirt/hooks, make sure it's called "qemu".
# After this file is installed, restart libvirt.
# From now on, you can easily add per-guest qemu hooks.
# Add your hooks in /etc/libvirt/hooks/qemu.d/vm_name/hook_name/state_name.
# For a list of available hooks, please refer to https://www.libvirt.org/hooks.html
#

GUEST_NAME="$1"
HOOK_NAME="$2"
STATE_NAME="$3"
# MISC="${@:4}" # MISC appears unused. Verify use (or export if used externally).

BASEDIR="$(dirname "$0")"

HOOKPATH="$BASEDIR/qemu.d/$GUEST_NAME/$HOOK_NAME/$STATE_NAME"

STDIN=$(cat) # Buffer the entirety of stdin so we can pass it on to other scripts. Moderately bad idea, but if the Rust folks can do it so can I.

# --- Automate PipeWire Access for QEMU ---
# If the VM XML contains a PipeWire audio configuration and the feature is enabled, grant the 'qemu' user access to the socket
if [ -f "/etc/ublue/virt-pipewire.enable" ] && echo "$STDIN" | grep -qE "type='pipewire'|type=\"pipewire\""; then
	# Extract runtimeDir using python (namespace-independent)
	RUNTIME_DIR=$(echo "$STDIN" | python3 -c "
import sys, xml.etree.ElementTree as ET
try:
    root = ET.fromstring(sys.stdin.read())
    for elem in root.iter():
        local_name = elem.tag.split('}')[-1]
        if local_name == 'audio' and elem.get('type') == 'pipewire':
            print(elem.get('runtimeDir', ''))
            break
except Exception:
    pass
" 2>/dev/null)

	# If runtimeDir was not found in XML, fallback to active user runtime directory
	if [ -z "$RUNTIME_DIR" ]; then
		ACTIVE_UID=$(loginctl list-users --no-legend 2>/dev/null | awk '$1 >= 1000 {print $1}' | head -n 1)
		RUNTIME_DIR="/run/user/${ACTIVE_UID:-1000}"
	fi

	# Apply/Remove ACL based on state
	if [ "$HOOK_NAME" = "prepare" ]; then
		if [ -d "$RUNTIME_DIR" ]; then
			setfacl -m u:qemu:x "$RUNTIME_DIR" 2>/dev/null || true
			if [ -S "$RUNTIME_DIR/pipewire-0" ]; then
				setfacl -m u:qemu:rw "$RUNTIME_DIR/pipewire-0" 2>/dev/null || true
			fi
		fi
	elif [ "$HOOK_NAME" = "release" ]; then
		if [ -d "$RUNTIME_DIR" ]; then
			setfacl -x u:qemu "$RUNTIME_DIR" 2>/dev/null || true
			if [ -S "$RUNTIME_DIR/pipewire-0" ]; then
				setfacl -x u:qemu "$RUNTIME_DIR/pipewire-0" 2>/dev/null || true
			fi
		fi
	fi
fi

set -e # If a script exits with an error, we should as well.

# check if it's a non-empty executable file
if [ -f "$HOOKPATH" ] && [ -s "$HOOKPATH" ] && [ -x "$HOOKPATH" ]; then
	"$HOOKPATH" "$@" <<<"$STDIN" # Call the hook with all our arguments and a copy of stdin.
elif [ -d "$HOOKPATH" ]; then
	while read -r file; do
		# check for null string
		if [ -n "$file" ]; then
			"$file" "$@" <<<"$STDIN" # Call each hook with all our arguments and a copy of stdin.
		fi
	done <<<"$(find -L "$HOOKPATH" -maxdepth 1 -type f -executable -print)"
fi
