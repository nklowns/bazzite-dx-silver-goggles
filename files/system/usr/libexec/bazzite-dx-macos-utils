#!/usr/bin/env bash
# ==============================================================================
# bazzite-dx-macos-utils: Lean macOS Hypervisor Helper (Bazzite-DX)
# Leverages quickget for official Apple CDN media and Libvirt for domain orchestration
# ==============================================================================
set -euo pipefail

bold="${bold:-}"
normal="${normal:-}"
green="${green:-}"
yellow="${yellow:-}"
red="${red:-}"

Choose() { :; }
# shellcheck disable=SC1091
if [[ -f /usr/lib/ujust/ujust.sh ]]; then
	source /usr/lib/ujust/ujust.sh
fi

MACOS_DIR="${MACOS_DIR:-/var/lib/libvirt/images/macos}"
LIBVIRT_URI="qemu:///system"
XML_TEMPLATE="/usr/share/ublue-os/virtualization/templates/macos.xml"

COMMAND="${1:-}"

if [[ -z "$COMMAND" ]]; then
	echo "${bold}🍏 macOS Virtualization Helper (Bazzite-DX Silver-Goggles)${normal}"
	echo "Hardware-accelerated macOS on Dell G15 (Intel 12th Gen Hybrid / OpenCore / KVM)."
	echo "Storage Pool: ${MACOS_DIR}"
	echo "----------------------------------------------------------------------"

	OPTION=$(
		Choose \
			"Status & Web Console URL" \
			"Start macOS VM (Ventura / Sonoma / Sequoia)" \
			"Safe Stop / Poweroff (QMP quit)" \
			"Force Stop / Destroy VM" \
			"Download macOS Recovery Media (via quickget)" \
			"Prepare Storage Pool, Firmware & Permissions" \
			"Register / Define Libvirt Domain"
	)
else
	OPTION="$COMMAND"
fi

case "$OPTION" in
*"Status"|status)
	echo "${bold}Hypervisor macOS Domains:${normal}"
	virsh -c "$LIBVIRT_URI" list --all | grep -E "macos|Id" || true
	echo ""
	echo "${bold}🌐 Cockpit Web Console (Local & Tailscale):${normal}"
	TS_FQDN=$(tailscale status --json 2>/dev/null | jq -r '.Self.DNSName // empty' | sed 's/\.$//' || true)
	if [[ -n "$TS_FQDN" ]]; then
		echo "  👉 https://${TS_FQDN}:61390/machines"
	fi
	echo "  👉 https://127.0.0.1:61390/machines"
	;;

*"Start"|start)
	TARGET_VM="${2:-}"
	if [[ -z "$TARGET_VM" ]]; then
		TARGET_VM=$(Choose "macos-ventura" "macos-sonoma" "macos-sequoia")
	fi
	RUNNING_VMS=$(virsh -c "$LIBVIRT_URI" list --name | grep -E "^macos-" || true)
	if [[ -n "$RUNNING_VMS" && "$RUNNING_VMS" != "$TARGET_VM" ]]; then
		echo "${red}${bold}SECURITY GUARD:${normal} Another macOS domain is already running: ${RUNNING_VMS}"
		echo "Stop it first before starting ${TARGET_VM}."
		exit 1
	fi
	echo "${bold}Starting ${TARGET_VM}...${normal}"
	virsh -c "$LIBVIRT_URI" start "$TARGET_VM" || true
	echo "${green}VM started! Console: https://127.0.0.1:61390/machines${normal}"
	;;

*"Safe Stop"|stop)
	TARGET_VM="${2:-}"
	if [[ -z "$TARGET_VM" ]]; then
		TARGET_VM=$(Choose "macos-ventura" "macos-sonoma" "macos-sequoia")
	fi
	echo "${bold}Sending safe QMP shutdown to ${TARGET_VM}...${normal}"
	virsh -c "$LIBVIRT_URI" qemu-monitor-command "$TARGET_VM" '{"execute": "quit"}' 2>/dev/null || virsh -c "$LIBVIRT_URI" shutdown "$TARGET_VM" || true
	echo "${green}Safe stop signal dispatched.${normal}"
	;;

*"Force Stop"|destroy)
	TARGET_VM="${2:-}"
	if [[ -z "$TARGET_VM" ]]; then
		TARGET_VM=$(Choose "macos-ventura" "macos-sonoma" "macos-sequoia")
	fi
	echo "${yellow}Sending emergency destroy signal to ${TARGET_VM}...${normal}"
	virsh -c "$LIBVIRT_URI" destroy "$TARGET_VM" || true
	echo "${green}VM stopped.${normal}"
	;;

*"Download macOS"|fetch)
	VERSION="${2:-}"
	if [[ -z "$VERSION" ]]; then
		VERSION=$(Choose "ventura" "sonoma" "sequoia" "monterey")
	fi
	echo "=== Downloading macOS ${VERSION} via quickget ==="
	sudo mkdir -p "$MACOS_DIR"
	TMP_DIR=$(mktemp -d)
	(
		cd "$TMP_DIR"
		quickget macos "$VERSION"
		if [[ -f "BaseSystem.dmg" ]]; then
			echo "Converting BaseSystem.dmg -> BaseSystem.img..."
			dmg2img -i "BaseSystem.dmg" -o "$MACOS_DIR/BaseSystem.img"
			sudo chown -R qemu:qemu "$MACOS_DIR"
			sudo restorecon -Rv "$MACOS_DIR"
			echo "${green}BaseSystem installed to ${MACOS_DIR}/BaseSystem.img${normal}"
		fi
	)
	rm -rf "$TMP_DIR"
	;;

*"Prepare Storage"|prepare)
	sudo mkdir -p "$MACOS_DIR"
	DISK_PATH="${MACOS_DIR}/macos-disk.img"
	echo "${bold}Checking Target RAW Virtual Disk (${DISK_PATH})...${normal}"
	if [[ -f "$DISK_PATH" ]]; then
		echo "Disk exists (${DISK_PATH})."
	else
		sudo qemu-img create -f raw "$DISK_PATH" 100G
		echo "${green}Created 100GB RAW disk.${normal}"
	fi

	echo ""
	echo "${bold}Checking Firmware & EFI Assets in ${MACOS_DIR}:${normal}"
	for asset in "OVMF_CODE_4M.fd" "OVMF_VARS-1024x768.fd" "OpenCore.qcow2" "BaseSystem.img"; do
		if [[ -f "${MACOS_DIR}/${asset}" ]]; then
			echo "  ✅ ${asset} found."
		else
			echo "  ⚠️ ${yellow}${asset} MISSING in ${MACOS_DIR}.${normal}"
		fi
	done

	echo ""
	echo "${bold}Applying SELinux Contexts & Permissions:${normal}"
	sudo chown -R qemu:qemu "$MACOS_DIR" 2>/dev/null || true
	sudo restorecon -Rv "$MACOS_DIR" 2>/dev/null || true
	echo "${green}SELinux labels and permissions synchronized.${normal}"
	;;

*"Register / Define"|define)
	if [[ ! -f "$XML_TEMPLATE" ]]; then
		XML_TEMPLATE="./virtualization/templates/macos.xml"
	fi
	TARGET_VERSION="${2:-}"
	if [[ -z "$TARGET_VERSION" ]]; then
		TARGET_VERSION=$(Choose "macos-ventura" "macos-sonoma" "macos-sequoia")
	fi
	DOMAIN_NAME=$(echo "$TARGET_VERSION" | awk '{print $1}')
	echo "${bold}Defining domain ${DOMAIN_NAME} from template...${normal}"
	TEMP_XML=$(mktemp)
	sed "s|<name>macos-ventura</name>|<name>${DOMAIN_NAME}</name>|g" "$XML_TEMPLATE" > "$TEMP_XML"
	virsh -c "$LIBVIRT_URI" define "$TEMP_XML"
	rm -f "$TEMP_XML"
	echo "${green}Domain ${DOMAIN_NAME} defined successfully in Libvirt!${normal}"
	;;

*)
	echo "Usage: bazzite-dx-macos-utils [status|start|stop|destroy|fetch|prepare|define] [args...]"
	exit 1
	;;
esac
