#!/usr/bin/env bash
set -euo pipefail

readonly GROUP_CONFIG_VERSION=1
readonly STATE_MARKER="/etc/ublue/dx-groups"
readonly SYSTEM_GROUPS=(
	"docker"
	"libvirt"
	"incus-admin"
	"dialout"
	"input"
	"video"
	"render"
	"plugdev"
	"adbusers"
)

# --- Group Provisioner Logic ---

IsStateSynchronized() {
	[[ -f "$STATE_MARKER" ]] && [[ "$(cat "$STATE_MARKER")" == "$GROUP_CONFIG_VERSION" ]]
}

SynchronizeSystemGroups() {
	for group_name in "${SYSTEM_GROUPS[@]}"; do
		# Transition groups from /usr/lib to /etc/group (Atomic Host requirements)
		if getent group "$group_name" >/dev/null && ! grep -q "^$group_name:" /etc/group; then
			grep "^$group_name:" /usr/lib/group >>/etc/group || true
		fi
	done
}

GrantDeveloperEntitlements() {
	local administrators
	administrators=$(getent group wheel | cut -d ":" -f 4 | tr ',' ' ')
	local provisioned_count=0

	for user in $administrators; do
		id "$user" >/dev/null 2>&1 || continue

		for group_name in "${SYSTEM_GROUPS[@]}"; do
			if getent group "$group_name" >/dev/null; then
				usermod -aG "$group_name" "$user"
				((provisioned_count++))
			fi
		done
	done
	return $provisioned_count
}

PersistStateMarker() {
	mkdir -p "$(dirname "$STATE_MARKER")"
	echo "$GROUP_CONFIG_VERSION" >"$STATE_MARKER"
}

# --- Principal Flow ---

if IsStateSynchronized; then
	exit 0
fi

SynchronizeSystemGroups

# Only persist the state marker if we actually found users to provision.
# This prevents a race condition on fresh installs where the user doesn't exist yet.
if GrantDeveloperEntitlements; then
	PersistStateMarker
else
	echo "No administrators found yet. Retrying on next boot."
fi
