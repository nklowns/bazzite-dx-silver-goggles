#!/usr/bin/env bash
set -euo pipefail

readonly GROUP_CONFIG_VERSION=3
readonly STATE_MARKER="/etc/ublue/dx-groups"
readonly SYSTEM_GROUPS=(
	"docker"
	"libvirt"
	"incus-admin"
	"dialout"
	"video"
	"render"
	"plugdev"
	"adbusers"
	"usershares"
)

# --- Group Provisioner Logic ---

IsStateSynchronized() {
	[[ -f "$STATE_MARKER" ]] && [[ "$(cat "$STATE_MARKER")" == "$GROUP_CONFIG_VERSION" ]]
}

SynchronizeSystemGroups() {
	for group_name in "${SYSTEM_GROUPS[@]}"; do
		# Transition groups from /usr/lib to /etc/group (Atomic Host requirements)
		if getent group "$group_name" >/dev/null && ! grep -q "^$group_name:" /etc/group; then
			grep "^$group_name:" /usr/lib/group >>/etc/group || true
		fi
	done
}

GrantDeveloperEntitlements() {
	local administrators
	administrators=$(getent group wheel | cut -d ":" -f 4 | tr ',' ' ')
	local provisioned_count=0

	for user in $administrators; do
		id "$user" >/dev/null 2>&1 || continue

		# Security: Revoke group 'input' membership from human users.
		# Group 'input' grants raw read access to /dev/input/event* (evdev), bypassing
		# Wayland compositor isolation and allowing arbitrary background keylogging.
		# Modern Linux uses dynamic logind/udev uaccess ACLs instead.
		if id -nG "$user" 2>/dev/null | grep -qw "input"; then
			echo "Security: revoking 'input' group from ${user} (protects Wayland evdev isolation)..."
			gpasswd -d "$user" input 2>/dev/null || true
		fi

		for group_name in "${SYSTEM_GROUPS[@]}"; do
			if getent group "$group_name" >/dev/null; then
				usermod -aG "$group_name" "$user"
				((provisioned_count++))
			fi
		done

		# Tailscale: Grant operator capability to the human administrator
		# Enables non-root control of Tailscale serve, status, and funnels for DX recipes
		if command -v tailscale >/dev/null 2>&1; then
			tailscale set --operator="$user" 2>/dev/null || true
		fi
	done
	# Return 0 (success) only when at least one user was provisioned.
	# Returning non-zero prevents PersistStateMarker from being called on
	# first-boot race conditions where no wheel member exists yet (OOBE not complete).
	return $((provisioned_count > 0 ? 0 : 1))
}

PersistStateMarker() {
	mkdir -p "$(dirname "$STATE_MARKER")"
	echo "$GROUP_CONFIG_VERSION" >"$STATE_MARKER"
}

ConfigureQemuAcl() {
	local qemu_conf="/etc/libvirt/qemu.conf"
	if [ -f "$qemu_conf" ]; then
		echo "Configuring Looking Glass QEMU ACL..."
		local has_kvmfr=0
		local _kvmfr_udev="/etc/udev/rules.d/99-kvmfr.rules"
		# A /dev/null symlink in /etc/ is the declarative opt-out mask.
		if [ -L "$_kvmfr_udev" ] && [ "$(readlink "$_kvmfr_udev" 2>/dev/null)" = "/dev/null" ]; then
			has_kvmfr=0 # explicitly masked
		elif [ -f "$_kvmfr_udev" ] || [ -f "/usr/lib/udev/rules.d/99-kvmfr.rules" ]; then
			has_kvmfr=1
		fi
		python3 -c '
import sys, re
path = sys.argv[1]
has_kvmfr = sys.argv[2] == "1"
try:
    with open(path, "r") as f:
        content = f.read()
    
    devices = [
        "/dev/null", "/dev/full", "/dev/zero",
        "/dev/random", "/dev/urandom",
        "/dev/ptmx", "/dev/kvm",
        "/dev/rtc", "/dev/hpet",
        "/dev/vfio/vfio", "/dev/userfaultfd"
    ]
    if has_kvmfr:
        devices.append("/dev/kvmfr0")
        
    devices_str = ",\n    ".join(f"\"{d}\"" for d in devices)
    replacement = f"cgroup_device_acl = [\n    {devices_str}\n]"
    
    if replacement in content:
        sys.exit(0)
            
    pattern = r"#?cgroup_device_acl\s*=\s*\[[^\]]*\]"
    if re.search(pattern, content):
        new_content = re.sub(pattern, replacement, content)
    else:
        new_content = content + "\n" + replacement + "\n"
        
    with open(path, "w") as f:
        f.write(new_content)
    print("qemu.conf configured successfully.")
except Exception as e:
    print(f"Error configuring qemu.conf: {e}", file=sys.stderr)
    sys.exit(1)
' "$qemu_conf" "$has_kvmfr"
	fi
}

ConfigureSelinux() {
	# Clean up any obsolete/colliding priority 400 module named 'bootupd' (renamed to bazzite-bootupd)
	if [ -f "/etc/selinux/targeted/active/modules/400/bootupd/cil" ]; then
		echo "Cleaning up obsolete/colliding bootupd module at priority 400..."
		semodule -X 400 -r bootupd 2>/dev/null || true
		rm -f "/etc/ublue/bootupd-policy.checksum"
	fi

	# Loop through all declarative CIL policies in the system image
	for policy_path in /usr/share/selinux/packages/*.cil; do
		[ -f "$policy_path" ] || continue
		local policy_name
		policy_name=$(basename "$policy_path" .cil)
		local checksum_file="/etc/ublue/${policy_name}-policy.checksum"

		# Check if the policy is optional and enabled
		local is_enabled=true
		if [ "$policy_name" = "pipewire" ]; then
			if [ ! -f "/etc/ublue/virt-pipewire.enable" ]; then
				is_enabled=false
			fi
		elif [ "$policy_name" = "kvmfr" ]; then
			# Masked (/dev/null symlink in /etc/) = kvmfr opt-out; skip SELinux policy.
			if [ -L "/etc/udev/rules.d/99-kvmfr.rules" ] &&
				[ "$(readlink /etc/udev/rules.d/99-kvmfr.rules 2>/dev/null)" = "/dev/null" ]; then
				is_enabled=false
			fi
		fi

		if [ "$is_enabled" = "true" ]; then
			local current_checksum
			current_checksum=$(sha256sum "$policy_path" | cut -d' ' -f1)

			local stored_checksum=""
			if [ -f "$checksum_file" ]; then
				stored_checksum=$(cat "$checksum_file")
			fi

			if [ "$current_checksum" != "$stored_checksum" ] || ! semodule -l | grep -q "^${policy_name}$"; then
				echo "Installing/updating SELinux custom policy for ${policy_name}..."
				if semodule -i "$policy_path"; then
					mkdir -p "$(dirname "$checksum_file")"
					echo "$current_checksum" >"$checksum_file"
				fi
			fi
		else
			# If policy is loaded but the feature is disabled, unload it
			if semodule -l | grep -q "^${policy_name}$"; then
				echo "Removing disabled SELinux custom policy for ${policy_name}..."
				semodule -r "${policy_name}" || true
				rm -f "$checksum_file"
			fi
		fi
	done
}

ConfigureLibvirtNss() {
	if ! authselect current | grep -q "with-libvirt"; then
		echo "Automating Libvirt NSS hostname resolution..."
		authselect enable-feature with-libvirt || true
		authselect apply-changes || true
	fi
}

ConfigureLibvirtSelinux() {
	local dir="/var/cache/libvirt"
	[ -d "$dir" ] || return 0

	# Ensure /var/cache/libvirt and subdirectories inherit the virt_cache_t SELinux context
	# (avoiding AVC denials when rpc-virtqemud writes capabilities xml in Cockpit Machines)
	if ! stat -c %C "$dir" 2>/dev/null | grep -q "virt_cache_t"; then
		echo "Restoring SELinux context for ${dir} (virt_cache_t)..."
		restorecon -R "$dir" 2>/dev/null || true
	fi
}

ConfigureSambaSelinux() {
	if getsebool samba_enable_home_dirs 2>/dev/null | grep -q "off$"; then
		echo "Enabling SELinux samba_enable_home_dirs boolean..."
		setsebool -P samba_enable_home_dirs on || true
	fi
}

ConfigureContainerSelinux() {
	# Without this, a container gets the NVIDIA device nodes injected and then cannot open
	# them. The failure reads like a driver problem and is not one — measured 2026-07-29,
	# with nvidia-persistenced up and /etc/cdi/nvidia.yaml freshly generated:
	#
	#     $ podman run --rm --device nvidia.com/gpu=all alpine sh -c 'ls /dev | grep nvidia'
	#     ls: /dev/nvidia0: Permission denied
	#     ls: /dev/nvidiactl: Permission denied
	#     ...
	#     $ setsebool container_use_devices on   # same command again
	#     nvidia-modeset  nvidia-uvm  nvidia-uvm-tools  nvidia0  nvidiactl
	#
	# container_use_dri_devices is already on and does NOT cover this: it is the iGPU/DRI
	# path, not the nvidia char devices. This is the last of three gates between a container
	# and the RTX 3060 — the other two are nvidia-persistenced actually starting and the CDI
	# spec being regenerated, both handled declaratively under files/system/usr/lib/systemd/.
	#
	# Engine-agnostic on purpose: podman and docker both label containers container_t, so
	# this is required either way and does not presuppose which engine a given stack uses.
	if getsebool container_use_devices 2>/dev/null | grep -q "off$"; then
		echo "Enabling SELinux container_use_devices boolean (GPU passthrough into containers)..."
		setsebool -P container_use_devices on || true
	fi
}

ConfigureClusterSelinux() {
	# Allows system daemons (such as lsblk invoked by Cockpit Storage) to query userdb sockets without denial
	if getsebool daemons_enable_cluster_mode 2>/dev/null | grep -q "off$"; then
		echo "Enabling SELinux daemons_enable_cluster_mode boolean..."
		setsebool -P daemons_enable_cluster_mode on || true
	fi
}

ClearAutologinObstacles() {
	# Makes the user's own autologin choice stick. Does NOT make that choice — see the note at
	# the end of this function for why the split matters.
	#
	# WHY AUTOLOGIN MATTERS HERE, on a machine that is otherwise conservative about this
	# sunshine.service carries Requisite=graphical-session.target — not Wants, not After. It
	# fails immediately if that target is inactive, and the target is only reached once someone
	# logs in graphically. Without autologin every reboot locks remote access out until a human
	# walks to the machine, which defeats the tailscale-first arrangement the rest of this image
	# is built around.
	#
	# The security ledger, measured rather than assumed:
	#   - zero LUKS partitions, so the login screen is not a boundary against physical access;
	#     anyone holding the machine boots a USB stick and reads the btrfs. It stops casual
	#     access, and the LOCK SCREEN stops exactly as much.
	#   - no pam_kwallet in /etc/pam.d, so autologin does not unlock the wallet. Secrets keep
	#     asking for their own password.
	#   - verified on this hardware: with the session locked, Sunshine still streams the lock
	#     screen and input reaches it, so unlocking remotely works. Without that test this would
	#     have been reckless — a Wayland compositor that refused to be captured while locked
	#     would leave a black stream, i.e. remote access that looks alive and is not.
	# The lock half is not optional. See the ujust that ties them together.
	local dropin_dir="/etc/plasmalogin.conf.d"
	[ -d "$dropin_dir" ] || return 0

	# Human accounts only. plasma-setup is a system account (uid 968) and must never be picked.
	local admins=() u uid
	for u in $(getent group wheel | cut -d: -f4 | tr ',' ' '); do
		uid=$(id -u "$u" 2>/dev/null) || continue
		[ "$uid" -ge 1000 ] 2>/dev/null && admins+=("$u")
	done

	if [ "${#admins[@]}" -eq 0 ]; then
		# FIRST BOOT OF A FRESH INSTALL. The out-of-box wizard has not created anyone yet, and
		# it is the thing that will. Suppressing it here would leave a machine nobody can log
		# into — return before touching anything.
		return 0
	fi

	# From here a human administrator exists, so the wizard has served its purpose.
	# plasma-setup.service guards on ConditionPathExists=!/etc/plasma-setup-done, and that file
	# is never created on this image — measured: the service ran 17 seconds into this boot and
	# rewrote the autologin config, as it does on every boot, planting
	# 99-plasma-setup.conf with User=plasma-setup. plasmalogin ignores it (system account) and
	# falls back to the greeter, so the visible effect is nil and the real effect is that any
	# autologin config here is in a permanent race. Ending the wizard removes the race entirely.
	# Blast radius checked: plasma-setup.service is the ONLY consumer of that path anywhere in
	# /usr/lib/systemd/system, /usr/libexec or /usr/bin. Undo with `rm /etc/plasma-setup-done`.
	if [ ! -f /etc/plasma-setup-done ]; then
		echo "Marking Plasma first-run setup complete (a human administrator exists)..."
		: >/etc/plasma-setup-done || true
	fi
	rm -f "$dropin_dir/99-plasma-setup.conf"

	# AND THAT IS ALL THIS DOES. It clears the ground; it does not configure autologin.
	#
	# An earlier version of this function wrote the [Autologin] block itself, resolving the
	# username at runtime so the image would not carry it. That was the right instinct and the
	# wrong owner: System Settings → Login Screen writes the same setting to
	# /etc/plasmalogin.conf, and a boot service that rewrote it would silently undo whatever the
	# user had just chosen in the UI. The failure mode is the worst kind — the official tool
	# appears not to work, and nothing explains why.
	#
	# It would also have got the value wrong. That version wrote `Session=plasma`; the KDE UI
	# writes `Session=plasma.desktop`, and the suffix matters — autologin fails back to the
	# greeter without it. The component that owns a setting knows its format; guessing at it
	# from a shell script does not.
	#
	# So the division is: this function removes what fights the user (a wizard that rewrites
	# autologin on every boot, and its stale drop-in), and the user owns the setting through the
	# UI. `ujust boot-audit` reports what is effective, so the visibility is not lost — only the
	# imposition is.
	if [ "${#admins[@]}" -gt 1 ]; then
		echo "Note: multiple human members of wheel (${admins[*]}). Autologin is configured in" \
			"System Settings → Login Screen and applies to whichever one is named there."
	fi
}

ConfigureCockpitPortLabel() {
	# Moving a port in a systemd drop-in is only half the job under SELinux: the policy
	# constrains which port LABEL a domain may bind, and cockpit_ws_t is allowed websm_port_t,
	# which by default covers only 9090. Relocating the socket to 61390 without relabelling
	# leaves the unit dead on arrival, with an error that names neither SELinux nor the port:
	#
	#     cockpit.socket: Failed to receive listening socket ([::]:61390): Input/output error
	#     cockpit.socket: Failed with result 'resources'.
	#
	# The audit log is where it actually says so:
	#
	#     avc: denied { name_bind } comm="(sd-listen)" src=61390
	#       scontext=system_u:system_r:cockpit_ws_t:s0
	#       tcontext=system_u:object_r:unreserved_port_t:s0
	#
	# Measured on a clean boot of the image that first shipped the drop-in — the port move
	# was verified in isolation beforehand and still broke here, because that check looked at
	# request origins and never at port labels.
	command -v semanage >/dev/null 2>&1 || return 0
	local listing
	if ! listing=$(semanage port -l 2>/dev/null); then
		echo "WARNING: cannot query SELinux port labels (needs root); Cockpit will fail to" \
			"bind 61390 until this runs privileged."
		return 0
	fi
	if grep '^websm_port_t' <<<"$listing" | grep -q '61390'; then
		return 0
	fi
	echo "Labelling tcp/61390 as websm_port_t so Cockpit may bind it..."
	semanage port -a -t websm_port_t -p tcp 61390 2>/dev/null ||
		semanage port -m -t websm_port_t -p tcp 61390 2>/dev/null || true
}

_EnsureNodatacow() {
	local dir="$1"
	local allow_nonempty="${2:-0}"
	[ -d "$dir" ] || return 0
	if lsattr -d "$dir" 2>/dev/null | awk '{print $1}' | grep -q 'C'; then
		return 0
	fi
	if [ "$allow_nonempty" -eq 0 ] && [ -n "$(ls -A "$dir" 2>/dev/null)" ]; then
		echo "WARNING: $dir already has contents; cannot enable btrfs nodatacow (+C only" \
			"affects files created after it is set). Existing data stays copy-on-write."
		return 0
	fi
	echo "Enabling btrfs nodatacow (+C) on $dir..."
	chattr +C "$dir" 2>/dev/null || true
}

_EnsureCacheDirTag() {
	local dir="$1"
	local desc="$2"
	local tag="$dir/CACHEDIR.TAG"
	[ -d "$dir" ] || return 0
	if [ ! -f "$tag" ]; then
		echo "Marking $dir as a cache directory for backup tools..."
		{
			echo "Signature: 8a477f597d28d172789f06886806bc55"
			echo "# ${desc}"
			echo "# Re-downloadable; excluded from backups by tools honouring CACHEDIR.TAG."
		} >"$tag" || true
	fi
	# Runs as root; hand ownership to uid 1000 so rootless containers can manage the tree.
	[ ! -f "$tag" ] || chown 1000:1000 "$tag" || true
}

_EnsureSelinuxFcontext() {
	local spec="$1"
	local target_dir="${2:-}"
	local listing="$3"
	if ! grep -qF "$spec" <<<"$listing"; then
		echo "Registering SELinux fcontext container_file_t for ${spec}..."
		semanage fcontext -a -t container_file_t "$spec" 2>/dev/null ||
			semanage fcontext -m -t container_file_t "$spec" 2>/dev/null || true
		if [ -n "$target_dir" ] && [ -d "$target_dir" ]; then
			restorecon -R "$target_dir" || true
		fi
	fi
}

ConfigureSrvStorage() {
	# Declarative /var/srv/* convergence driven by /usr/lib/tmpfiles.d/*.conf.
	# tmpfiles.d owns directory creation (d) and declares btrfs nodatacow targets (h ... +C);
	# this function converges +C on existing dirs, writes CACHEDIR.TAG markers, enforces
	# RustDesk private key permissions, and registers SELinux container_file_t labels in one pass.
	local tmpfiles_dir="${DX_TMPFILES_DIR:-/usr/lib/tmpfiles.d}"
	[ -d "$tmpfiles_dir" ] || return 0

	# 1. RustDesk private permissions (directory + ed25519 private key)
	if [ -d /var/srv/rustdesk ]; then
		chmod 0700 /var/srv/rustdesk 2>/dev/null || true
		[ ! -f /var/srv/rustdesk/id_ed25519 ] || chmod 0600 /var/srv/rustdesk/id_ed25519 2>/dev/null || true
	fi

	# 2. Btrfs nodatacow (+C) for every /var/srv/* directory declared in tmpfiles.d
	local dir tf
	while IFS= read -r dir; do
		[ -n "$dir" ] || continue
		if [ "$dir" = "/var/srv/rustdesk" ]; then
			_EnsureNodatacow "$dir" 1
		else
			_EnsureNodatacow "$dir" 0
		fi
	done < <(
		for tf in "$tmpfiles_dir"/*.conf; do
			[ -r "$tf" ] || continue
			awk '$1 == "h" && $2 ~ /^\/var\/srv\// && $NF ~ /\+C/ {print $2}' "$tf"
		done | sort -u
	)

	# 3. Backup exclusions (CACHEDIR.TAG) for bulk re-downloadable content
	_EnsureCacheDirTag "/var/srv/nomad/storage" "Project NOMAD offline content (ZIM archives, model weights, maps)."
	_EnsureCacheDirTag "/var/srv/visual" "AI Studio Visual offline content (model weights, checkpoints, LoRAs)."
	_EnsureCacheDirTag "/var/srv/audio" "AI Audio Studio offline content (TTS/STT ONNX models, MusicGen, voices)."

	# 4. SELinux container_file_t labeling — single `semanage fcontext -l` query for all roots
	command -v semanage >/dev/null 2>&1 || return 0
	local listing
	if ! listing=$(semanage fcontext -l 2>/dev/null); then
		echo "WARNING: cannot query SELinux fcontext (needs root); skipping /var/srv label registration."
		return 0
	fi

	local root
	while IFS= read -r root; do
		[ -d "$root" ] || continue
		_EnsureSelinuxFcontext "${root}(/.*)?" "$root" "$listing"
	done < <(
		for tf in "$tmpfiles_dir"/*.conf; do
			[ -r "$tf" ] || continue
			awk '$1 == "d" && $2 ~ /^\/var\/srv\/[^\/]+$/ {print $2}' "$tf"
		done | sort -u
	)

	# User deliverables under ~/Pictures/AI_Studio and ~/Music/AI_Studio
	if [ -d /var/srv/visual ]; then
		_EnsureSelinuxFcontext "/var/home/[^/]+/Pictures/AI_Studio(/.*)?" "" "$listing"
	fi
	if [ -d /var/srv/audio ]; then
		_EnsureSelinuxFcontext "/var/home/[^/]+/Music/AI_Studio(/.*)?" "" "$listing"
	fi
}

ConfigureFirewall() {
	if command -v firewall-cmd >/dev/null; then
		local def_zone
		def_zone=$(firewall-cmd --get-default-zone 2>/dev/null || true)
		if [ "$def_zone" = "FedoraWorkstation" ]; then
			echo "Hardening firewall: changing default zone from FedoraWorkstation to public..."
			firewall-cmd --set-default-zone=public || true
		fi
		if ! firewall-cmd --zone=trusted --query-interface=tailscale0 >/dev/null 2>&1; then
			echo "Adding tailscale0 interface to trusted firewall zone..."
			firewall-cmd --permanent --zone=trusted --add-interface=tailscale0 || true
			firewall-cmd --reload || true
		fi
	fi
}

ConfigurePcpServices() {
	# 1. Enable NVIDIA PMDA in pmcd if available and not yet registered
	if [ -f "/var/lib/pcp/pmdas/nvidia/Install" ] && [ -f "/etc/pcp/pmcd/pmcd.conf" ]; then
		if ! grep -q "^nvidia" /etc/pcp/pmcd/pmcd.conf; then
			echo "Registering Performance Co-Pilot NVIDIA GPU PMDA..."
			(cd /var/lib/pcp/pmdas/nvidia && printf "y\ny\n" | ./Install) >/dev/null 2>&1 || true
		fi
	fi

	# 2. Ensure pmproxy is active for Cockpit metrics web UI
	if systemctl is-active --quiet pmcd.service && ! systemctl is-active --quiet pmproxy.service; then
		systemctl start pmproxy.service 2>/dev/null || true
	fi

	# 3. Disable copy-on-write on Btrfs for PCP pmlogger archive directories
	# Continuous append/write cycles in active archive logs cause severe extent fragmentation
	# and metadata write amplification on NVMe Btrfs. Setting +C ensures in-place overwrites.
	local pmlog_dir="/var/log/pcp/pmlogger"
	if [ -d "$pmlog_dir" ]; then
		if ! lsattr -d "$pmlog_dir" 2>/dev/null | awk '{print $1}' | grep -q 'C'; then
			echo "Enabling btrfs nodatacow (+C) on ${pmlog_dir}..."
			chattr +C "$pmlog_dir" 2>/dev/null || true
		fi
		local subdir
		for subdir in "$pmlog_dir"/*; do
			if [ -d "$subdir" ] && ! lsattr -d "$subdir" 2>/dev/null | awk '{print $1}' | grep -q 'C'; then
				chattr +C "$subdir" 2>/dev/null || true
			fi
		done
	fi
}

SanitizeUserMediaContexts() {
	# Self-healing: sanitizes alien dosfs_t labels inherited from FAT/exFAT USBs or Windows migrations
	# inside user media folders. Only touches files explicitly carrying dosfs_t, skipping AI_Studio subtrees.
	command -v restorecon >/dev/null 2>&1 || return 0
	local user_home
	for user_home in /var/home/*; do
		[ -d "$user_home" ] || continue
		local media_dir
		for media_dir in "$user_home/Pictures" "$user_home/Videos" "$user_home/Music"; do
			[ -d "$media_dir" ] || continue
			while IFS=' ' read -r ctx filepath; do
				if [[ "$ctx" == *dosfs_t* ]] && [[ -n "$filepath" ]]; then
					echo "Self-healing: restoring canonical SELinux context on $filepath..."
					restorecon "$filepath" 2>/dev/null || true
				fi
			done < <(find "$media_dir" -name "AI_Studio" -prune -o -exec stat -c "%C %n" {} + 2>/dev/null)
		done
	done
}

# --- Principal Flow ---

ConfigureQemuAcl
ConfigureSelinux
ConfigureLibvirtNss
ConfigureLibvirtSelinux
ConfigureSambaSelinux
ConfigureContainerSelinux
ConfigureClusterSelinux
ClearAutologinObstacles
ConfigureCockpitPortLabel
ConfigureSrvStorage
ConfigureFirewall
ConfigurePcpServices
SanitizeUserMediaContexts

if IsStateSynchronized; then
	exit 0
fi

SynchronizeSystemGroups

# Only persist the state marker if we actually found users to provision.
# This prevents a race condition on fresh installs where the user doesn't exist yet.
if GrantDeveloperEntitlements; then
	PersistStateMarker
else
	echo "No administrators found yet. Retrying on next boot."
fi
