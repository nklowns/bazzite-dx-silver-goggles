#!/usr/bin/env bash
set -euo pipefail

readonly GROUP_CONFIG_VERSION=2
readonly STATE_MARKER="/etc/ublue/dx-groups"
readonly SYSTEM_GROUPS=(
	"docker"
	"libvirt"
	"incus-admin"
	"dialout"
	"input"
	"video"
	"render"
	"plugdev"
	"adbusers"
	"usershares"
)

# --- Group Provisioner Logic ---

IsStateSynchronized() {
	[[ -f "$STATE_MARKER" ]] && [[ "$(cat "$STATE_MARKER")" == "$GROUP_CONFIG_VERSION" ]]
}

SynchronizeSystemGroups() {
	for group_name in "${SYSTEM_GROUPS[@]}"; do
		# Transition groups from /usr/lib to /etc/group (Atomic Host requirements)
		if getent group "$group_name" >/dev/null && ! grep -q "^$group_name:" /etc/group; then
			grep "^$group_name:" /usr/lib/group >>/etc/group || true
		fi
	done
}

GrantDeveloperEntitlements() {
	local administrators
	administrators=$(getent group wheel | cut -d ":" -f 4 | tr ',' ' ')
	local provisioned_count=0

	for user in $administrators; do
		id "$user" >/dev/null 2>&1 || continue

		for group_name in "${SYSTEM_GROUPS[@]}"; do
			if getent group "$group_name" >/dev/null; then
				usermod -aG "$group_name" "$user"
				((provisioned_count++))
			fi
		done
	done
	# Return 0 (success) only when at least one user was provisioned.
	# Returning non-zero prevents PersistStateMarker from being called on
	# first-boot race conditions where no wheel member exists yet (OOBE not complete).
	return $(( provisioned_count > 0 ? 0 : 1 ))
}

PersistStateMarker() {
	mkdir -p "$(dirname "$STATE_MARKER")"
	echo "$GROUP_CONFIG_VERSION" >"$STATE_MARKER"
}

ConfigureQemuAcl() {
	local qemu_conf="/etc/libvirt/qemu.conf"
	if [ -f "$qemu_conf" ]; then
		echo "Configuring Looking Glass QEMU ACL..."
		local has_kvmfr=0
		local _kvmfr_udev="/etc/udev/rules.d/99-kvmfr.rules"
		# A /dev/null symlink in /etc/ is the declarative opt-out mask.
		if [ -L "$_kvmfr_udev" ] && [ "$(readlink "$_kvmfr_udev" 2>/dev/null)" = "/dev/null" ]; then
			has_kvmfr=0  # explicitly masked
		elif [ -f "$_kvmfr_udev" ] || [ -f "/usr/lib/udev/rules.d/99-kvmfr.rules" ]; then
			has_kvmfr=1
		fi
		python3 -c '
import sys, re
path = sys.argv[1]
has_kvmfr = sys.argv[2] == "1"
try:
    with open(path, "r") as f:
        content = f.read()
    
    devices = [
        "/dev/null", "/dev/full", "/dev/zero",
        "/dev/random", "/dev/urandom",
        "/dev/ptmx", "/dev/kvm",
        "/dev/rtc", "/dev/hpet",
        "/dev/vfio/vfio", "/dev/userfaultfd"
    ]
    if has_kvmfr:
        devices.append("/dev/kvmfr0")
        
    devices_str = ",\n    ".join(f"\"{d}\"" for d in devices)
    replacement = f"cgroup_device_acl = [\n    {devices_str}\n]"
    
    if replacement in content:
        sys.exit(0)
            
    pattern = r"#?cgroup_device_acl\s*=\s*\[[^\]]*\]"
    if re.search(pattern, content):
        new_content = re.sub(pattern, replacement, content)
    else:
        new_content = content + "\n" + replacement + "\n"
        
    with open(path, "w") as f:
        f.write(new_content)
    print("qemu.conf configured successfully.")
except Exception as e:
    print(f"Error configuring qemu.conf: {e}", file=sys.stderr)
    sys.exit(1)
' "$qemu_conf" "$has_kvmfr"
	fi
}

ConfigureSelinux() {
	# Loop through all declarative CIL policies in the system image
	for policy_path in /usr/share/selinux/packages/*.cil; do
		[ -f "$policy_path" ] || continue
		local policy_name
		policy_name=$(basename "$policy_path" .cil)
		local checksum_file="/etc/ublue/${policy_name}-policy.checksum"
		
		# Check if the policy is optional and enabled
		local is_enabled=true
		if [ "$policy_name" = "pipewire" ]; then
			if [ ! -f "/etc/ublue/virt-pipewire.enable" ]; then
				is_enabled=false
			fi
		elif [ "$policy_name" = "kvmfr" ]; then
			# Masked (/dev/null symlink in /etc/) = kvmfr opt-out; skip SELinux policy.
			if [ -L "/etc/udev/rules.d/99-kvmfr.rules" ] && \
			   [ "$(readlink /etc/udev/rules.d/99-kvmfr.rules 2>/dev/null)" = "/dev/null" ]; then
				is_enabled=false
			fi
		fi

		if [ "$is_enabled" = "true" ]; then
			local current_checksum
			current_checksum=$(sha256sum "$policy_path" | cut -d' ' -f1)
			
			local stored_checksum=""
			if [ -f "$checksum_file" ]; then
				stored_checksum=$(cat "$checksum_file")
			fi
			
			if [ "$current_checksum" != "$stored_checksum" ] || ! semodule -l | grep -q "^${policy_name}$"; then
				echo "Installing/updating SELinux custom policy for ${policy_name}..."
				if semodule -i "$policy_path"; then
					mkdir -p "$(dirname "$checksum_file")"
					echo "$current_checksum" > "$checksum_file"
				fi
			fi
		else
			# If policy is loaded but the feature is disabled, unload it
			if semodule -l | grep -q "^${policy_name}$"; then
				echo "Removing disabled SELinux custom policy for ${policy_name}..."
				semodule -r "${policy_name}" || true
				rm -f "$checksum_file"
			fi
		fi
	done
}

ConfigureLibvirtNss() {
	if ! authselect current | grep -q "with-libvirt"; then
		echo "Automating Libvirt NSS hostname resolution..."
		authselect enable-feature with-libvirt || true
		authselect apply-changes || true
	fi
}

ConfigureSambaSelinux() {
	if getsebool samba_enable_home_dirs 2>/dev/null | grep -q "off$"; then
		echo "Enabling SELinux samba_enable_home_dirs boolean..."
		setsebool -P samba_enable_home_dirs on || true
	fi
}

ConfigureContainerSelinux() {
	# Without this, a container gets the NVIDIA device nodes injected and then cannot open
	# them. The failure reads like a driver problem and is not one — measured 2026-07-29,
	# with nvidia-persistenced up and /etc/cdi/nvidia.yaml freshly generated:
	#
	#     $ podman run --rm --device nvidia.com/gpu=all alpine sh -c 'ls /dev | grep nvidia'
	#     ls: /dev/nvidia0: Permission denied
	#     ls: /dev/nvidiactl: Permission denied
	#     ...
	#     $ setsebool container_use_devices on   # same command again
	#     nvidia-modeset  nvidia-uvm  nvidia-uvm-tools  nvidia0  nvidiactl
	#
	# container_use_dri_devices is already on and does NOT cover this: it is the iGPU/DRI
	# path, not the nvidia char devices. This is the last of three gates between a container
	# and the RTX 3060 — the other two are nvidia-persistenced actually starting and the CDI
	# spec being regenerated, both handled declaratively under files/system/usr/lib/systemd/.
	#
	# Engine-agnostic on purpose: podman and docker both label containers container_t, so
	# this is required either way and does not presuppose which engine a given stack uses.
	if getsebool container_use_devices 2>/dev/null | grep -q "off$"; then
		echo "Enabling SELinux container_use_devices boolean (GPU passthrough into containers)..."
		setsebool -P container_use_devices on || true
	fi
}

ConfigureNomadStorage() {
	local root="/var/srv/nomad"
	# tmpfiles.d owns creation (see /usr/lib/tmpfiles.d/project-nomad.conf). If the tree is
	# not there yet, do nothing — tmpfiles runs in sysinit.target and will have made it by
	# the next boot. Never create it here: two creators means two opinions about ownership.
	[ -d "$root" ] || return 0

	# --- btrfs: disable copy-on-write for the database directories ---------------------
	# MySQL and Redis do random writes inside large files, which is the pathological case
	# for CoW: every write forks a new extent, fragmenting the file and amplifying writes
	# on the NVMe. Measured on this host: /var is btrfs, rw,relatime,ssd,discard=async,
	# space_cache=v2, no compression, and no nodatacow anywhere.
	#
	# The catch that makes this urgent rather than nice-to-have: +C is inherited by files
	# created afterwards and does NOTHING to files that already exist. There is exactly one
	# moment to set it — while the directory is still empty. Once mysqld has initialised its
	# datadir the only fix is recreating the database, so a directory with contents is
	# reported and skipped rather than given a reassuring no-op.
	local dir
	for dir in "$root/mysql" "$root/redis"; do
		[ -d "$dir" ] || continue
		if lsattr -d "$dir" 2>/dev/null | awk '{print $1}' | grep -q 'C'; then
			continue
		fi
		if [ -n "$(ls -A "$dir" 2>/dev/null)" ]; then
			echo "WARNING: $dir already has contents; cannot enable btrfs nodatacow (+C only" \
				"affects files created after it is set). Existing data stays copy-on-write."
			continue
		fi
		echo "Enabling btrfs nodatacow on empty $dir..."
		chattr +C "$dir" || true
	done

	# --- Exclude the bulk data from any future backup ----------------------------------
	# CACHEDIR.TAG is a cross-tool convention honoured by restic (installed here), borg, tar,
	# duplicity and rsync --exclude-caches. Written now, before any backup exists, precisely
	# so that whichever tool shows up later inherits the right answer without an exclude list
	# to maintain. The claim is honest: ZIM archives and model weights are re-downloadable.
	# The signature line is a fixed magic string — it must be byte-exact and come first.
	local tag="$root/storage/CACHEDIR.TAG"
	if [ -d "$root/storage" ] && [ ! -f "$tag" ]; then
		echo "Marking $root/storage as a cache directory for backup tools..."
		{
			echo "Signature: 8a477f597d28d172789f06886806bc55"
			echo "# Project NOMAD offline content (ZIM archives, model weights, maps)."
			echo "# Re-downloadable through the Command Center; excluded from backups by"
			echo "# tools honouring the CACHEDIR.TAG convention."
		} >"$tag" || true
	fi

	# --- SELinux: label the tree so containers can actually use it ---------------------
	# Measured: a bind mount of an unlabelled directory is denied outright to a container
	# (touch -> Permission denied), and the same bind works once the directory is
	# container_file_t. This cannot be solved with :z on our own volumes alone, because the
	# Command Center generates binds for every Supply Depot app it spawns and those carry no
	# :z and cannot be given one — labelling the root covers all of them at once.
	command -v semanage >/dev/null 2>&1 || return 0
	local spec="${root}(/.*)?" listing
	# Capture the listing rather than piping it, so "no entry" is distinguishable from
	# "could not ask". Piping conflated them: `semanage fcontext -l` fails without root, the
	# empty output failed the grep, and the negation then reported the rule as missing on
	# every single run. Match with -F — the spec contains (, ), ? and *, none of which mean
	# themselves in a basic regex.
	if ! listing=$(semanage fcontext -l 2>/dev/null); then
		echo "WARNING: cannot query SELinux fcontext (needs root); skipping label registration." \
			"Containers will be denied access to ${root} until this runs privileged."
		return 0
	fi
	if ! grep -qF "$spec" <<<"$listing"; then
		echo "Registering SELinux fcontext container_file_t for ${root}..."
		semanage fcontext -a -t container_file_t "$spec" 2>/dev/null ||
			semanage fcontext -m -t container_file_t "$spec" 2>/dev/null || true
		restorecon -R "$root" || true
	fi
}

ConfigureFirewall() {
	if command -v firewall-cmd >/dev/null; then
		if ! firewall-cmd --zone=trusted --query-interface=tailscale0 >/dev/null 2>&1; then
			echo "Adding tailscale0 interface to trusted firewall zone..."
			firewall-cmd --permanent --zone=trusted --add-interface=tailscale0 || true
			firewall-cmd --reload || true
		fi
	fi
}

# --- Principal Flow ---

ConfigureQemuAcl
ConfigureSelinux
ConfigureLibvirtNss
ConfigureSambaSelinux
ConfigureContainerSelinux
ConfigureFirewall

if IsStateSynchronized; then
	exit 0
fi

SynchronizeSystemGroups

# Only persist the state marker if we actually found users to provision.
# This prevents a race condition on fresh installs where the user doesn't exist yet.
if GrantDeveloperEntitlements; then
	PersistStateMarker
else
	echo "No administrators found yet. Retrying on next boot."
fi
