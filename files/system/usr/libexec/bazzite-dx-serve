#!/usr/bin/env bash
# Shared `tailscale serve` handling for the remote-* ujust recipes. Executed, not sourced —
# each just recipe is its own shell, so a command is more useful here than a library.
#
# WHY THIS EXISTS
# ---------------
# Three recipes (remote-ide-setup, remote-cockpit-setup, remote-nomad-setup) each carried their
# own copy of the same idempotency guard:
#
#     if tailscale serve status | grep -q 'proxy http://127.0.0.1:61337'; then
#         echo "already proxies 61337 — left as is."
#
# That grep matches the proxy TARGET and ignores which listener it hangs off. Measured on this
# host, the difference is not academic:
#
#     https://<tailscale-fqdn>        -> proxy http://127.0.0.1:61337   <- ROOT
#     https://<tailscale-fqdn>:9090   -> proxy http://127.0.0.1:9090
#
# code-server was published on the bare tailnet domain, which this layer reserves so a project
# can claim it. The recipe was later fixed to pass `--https=61337`, and the fix is inert: the
# old root mapping still satisfies the grep, so the recipe reports success and migrates
# nothing. A no-op that reads as "already correct" is worse than a failure — it looks resolved
# in the diff and changes nothing on the machine.
#
# `tailscale serve status --json` exposes the actual shape, so ask it instead of grepping prose:
#     .Web["<host>:<port>"].Handlers["/"].Proxy
set -euo pipefail

Usage() {
	cat <<-EOF
		usage: ${0##*/} <command> <port>

		  status <port>   prints ok | misplaced:<listener> | absent
		  ensure <port>   idempotently publish <port> on the tailnet at the same port
		  off <port>      stop publishing <port>
	EOF
	exit 2
}

# Prints the listeners whose "/" handler proxies to target_scheme://127.0.0.1:<target_port>, one per line.
_ListenersProxyingTo() {
	local target_port="$1"
	local target_scheme="${2:-http}"
	local expected_proxy="${target_scheme}://127.0.0.1:${target_port}"
	tailscale serve status --json 2>/dev/null |
		jq -r --arg proxy "$expected_proxy" '
			(.Web // {}) | to_entries[]
			| select((.value.Handlers["/"].Proxy // "") == $proxy)
			| .key
		' 2>/dev/null || true
}

Status() {
	local listen_port="$1"
	local target_port="${2:-$listen_port}"
	local target_scheme="${3:-http}"
	local listener
	while IFS= read -r listener; do
		[ -n "$listener" ] || continue
		if [[ "$listener" == *:"$listen_port" ]]; then
			echo "ok"
			return 0
		fi
		echo "misplaced:${listener}"
		return 0
	done < <(_ListenersProxyingTo "$target_port" "$target_scheme")
	echo "absent"
}

Ensure() {
	local listen_port="$1"
	local target_port="${2:-$listen_port}"
	local target_scheme="${3:-http}"
	local target_uri="${target_scheme}://127.0.0.1:${target_port}"

	# Check Tailscale health before trying to publish
	if ! command -v tailscale >/dev/null 2>&1; then
		echo "❌ Tailscale não está instalado no PATH." >&2
		return 1
	fi

	local ts_state
	ts_state=$(tailscale status --json 2>/dev/null | jq -r '.BackendState // "Stopped"' 2>/dev/null || echo "Stopped")
	if [[ "$ts_state" != "Running" ]]; then
		echo "⚠️  Tailscale não está rodando (Estado: ${ts_state}). Inicie o Tailscale com 'sudo tailscale up'." >&2
		return 1
	fi

	local is_online
	is_online=$(tailscale status --json 2>/dev/null | jq -r '.Self.Online // false' 2>/dev/null || echo "false")
	if [[ "$is_online" != "true" ]]; then
		echo "⚠️  Este nó está offline no Tailscale. Verifique sua conexão com a rede." >&2
	fi

	local state
	state=$(Status "$listen_port" "$target_port" "$target_scheme")
	case "$state" in
	ok)
		echo "tailscale serve já publica ${listen_port} (apontando para ${target_uri}) — mantido."
		return 0
		;;
	misplaced:*)
		local where="${state#misplaced:}"
		echo "⚠️  A porta ${target_port} está publicada no listener errado: ${where}"
		echo "    Isso ocupa um endpoint do tailnet que deveria estar livre. Para migrar:"
		echo "        sudo tailscale serve --https=${where##*:} off"
		echo "        sudo tailscale serve --bg --https=${listen_port} ${target_uri}"
		echo "    (não faço isso sozinho: outra máquina pode estar usando essa URL agora)"
		return 0
		;;
	esac
	# absent — publish it. Needs root unless `tailscale set --operator=$USER` was run once.
	if tailscale serve --bg --https="$listen_port" "$target_uri" 2>/dev/null; then
		return 0
	fi
	echo "Não consegui configurar o 'tailscale serve' (precisa de root aqui). Rode:"
	echo "    sudo tailscale serve --bg --https=${listen_port} ${target_uri}"
	echo "    sudo tailscale set --operator=${USER}   # uma vez, e este recipe passa a funcionar"
	return 1
}

Off() {
	local listen_port="$1"
	if ! tailscale serve --https="$listen_port" off 2>/dev/null; then
		echo "Não consegui remover (precisa de root). Rode:"
		echo "    sudo tailscale serve --https=${listen_port} off"
		return 1
	fi
}

[ $# -ge 2 ] || Usage
case "$1" in
status) Status "$2" "${3:-}" "${4:-}" ;;
ensure) Ensure "$2" "${3:-}" "${4:-}" ;;
off) Off "$2" ;;
*) Usage ;;
esac
