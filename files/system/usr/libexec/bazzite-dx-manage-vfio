#!/usr/bin/env bash
# Manage GPU Passthrough (Bind/Unbind NVIDIA GPU to VFIO)

b="${b:-}"
n="${n:-}"
green="${green:-}"
red="${red:-}"
yellow="${yellow:-}"
bold="${bold:-}"
normal="${normal:-}"

Choose() { :; }
# shellcheck disable=SC1091
source /usr/lib/ujust/ujust.sh
# shellcheck disable=SC1091
source /usr/libexec/bazzite-dx-virt-lib
ACTION="$1"

echo "${bold}VFIO GPU Passthrough Manager${normal}"
echo "${red}${b}WARNING:${n} On Bazzite-NVIDIA laptops, binding the GPU may cause a ${yellow}BLACK SCREEN${n}"
echo "if your BIOS is not in 'Hybrid/Optimus' mode or if the OS fails to fallback to Intel/AMD iGPU."
echo "----------------------------------------------------------------------"

OPTION="$ACTION"
if [ -z "$OPTION" ]; then
	OPTION=$(
		Choose \
			"Bind NVIDIA GPU to VFIO (Require Reboot)" \
			"Unbind GPU (Return to Host)" \
			"Check Current GPU Status" \
			"Setup VFIO Hot-Swap Hooks"
	)
fi

if [[ "$OPTION" =~ "Bind" ]]; then
	echo "Searching for NVIDIA GPU IDs..."
	# Extract all PCI IDs for NVIDIA devices (vendor 10de), which includes VGA, Audio, USB-C, and UCSI
	NVIDIA_IDS=$(lspci -nn | grep -i "NVIDIA" | grep -o "10de:[0-9a-fA-F]\{4\}" | sort -u | paste -sd, - || true)

	if [ -z "$NVIDIA_IDS" ]; then
		echo "${red}Error:${n} Could not detect an NVIDIA GPU."
		exit 1
	fi

	VFIO_IDS="$NVIDIA_IDS"

	echo "Found NVIDIA IDs (including sub-devices): ${green}$VFIO_IDS${n}"
	echo "Appending to kernel arguments..."
	rpm-ostree kargs \
		--append-if-missing="vfio_pci.ids=$VFIO_IDS" \
		--append-if-missing="rd.driver.pre=vfio-pci"
	echo "${yellow}Reboot required${n} to apply GPU binding."

elif [[ "$OPTION" =~ "Unbind" ]]; then
	echo "Removing VFIO bindings from kernel arguments..."
	VFIO_IDS_KARG="$(rpm-ostree kargs | grep -o 'vfio_pci.ids=[^ ]*' || true)"
	if [ -n "$VFIO_IDS_KARG" ]; then
		rpm-ostree kargs \
			--delete-if-present="$VFIO_IDS_KARG" \
			--delete-if-present="rd.driver.pre=vfio-pci"
		echo "Binding removed. ${yellow}Reboot required${n} to return GPU to host."
	else
		echo "No vfio_pci.ids found in kernel arguments. GPU is likely already attached to the host."
	fi

elif [[ "$OPTION" =~ "Check" ]]; then
	echo "Checking current driver for NVIDIA GPU..."
	lspci -nnk | grep -iA 3 "NVIDIA" | grep "Kernel driver in use" || echo "GPU not active or found."

	echo ""
	echo "Current VFIO Kernel Args:"
	rpm-ostree kargs | grep -o "vfio_pci.ids=[^ ]*" || echo "None"

elif [[ "$OPTION" =~ "Hot-Swap" ]]; then
	echo "${bold}Dynamic VFIO (Hot-Swap) Setup${normal}"
	echo "${red}${b}WARNING:${n} Dynamic unbinding of the primary NVIDIA GPU on Wayland/KDE is highly experimental."
	echo "It usually requires stopping the Display Manager (SDDM) completely."
	echo "----------------------------------------------------------------------"
	echo "Creating Libvirt Hook directory structure..."
	sudo mkdir -p /etc/libvirt/hooks/qemu.d
	EnsureQEMUHook

	echo "${green}Hook structure created in /etc/libvirt/hooks/qemu.d/${n}"
	echo "To implement Hot-Swap for a VM named 'win11':"
	echo "1. Create: /etc/libvirt/hooks/qemu.d/win11/prepare/begin/start.sh"
	echo "2. Create: /etc/libvirt/hooks/qemu.d/win11/release/end/stop.sh"
	echo "Note: Search for 'Single GPU Passthrough' guides for exact script contents."
fi
