#!/usr/bin/env bash
# Generates configuration files for SearXNG and Vane on first run only.
# Never overwrites existing files, preserving custom user engines, API keys, and settings across rebases.
set -euo pipefail

# Ensure proper rootless container namespace permissions for /var/srv volumes
if [[ -z "${CONTAINERS_UNSHARE:-}" && "$EUID" -ne 0 ]]; then
	exec podman unshare env CONTAINERS_UNSHARE=1 "$0" "$@"
fi

SEARXNG_DIR="/var/srv/searxng"
VANE_DIR="/var/srv/vane"

mkdir -p "$SEARXNG_DIR" "$VANE_DIR/data"

# 1. SearXNG Configuration (5 Spheres)
SEARXNG_SETTINGS="$SEARXNG_DIR/settings.yml"
TEMPLATE_SETTINGS="/usr/share/searxng/settings.template.yml"
if [[ ! -f "$TEMPLATE_SETTINGS" && -f "/var/home/cloud/dev/linux/uBlueOs/bazzite-dx-silver-goggles/files/system/usr/share/searxng/settings.template.yml" ]]; then
	TEMPLATE_SETTINGS="/var/home/cloud/dev/linux/uBlueOs/bazzite-dx-silver-goggles/files/system/usr/share/searxng/settings.template.yml"
fi

if [[ -f "$TEMPLATE_SETTINGS" ]]; then
	SECRET_KEY=""
	if [[ -f "$SEARXNG_SETTINGS" ]]; then
		SECRET_KEY=$(grep -E '^\s*secret_key:' "$SEARXNG_SETTINGS" | head -n1 | sed -E 's/.*secret_key:\s*"?([^"]*)"?/\1/' || true)
		cp -a "$SEARXNG_SETTINGS" "${SEARXNG_SETTINGS}.bak"
	fi
	if [[ -z "$SECRET_KEY" ]]; then
		SECRET_KEY="$(openssl rand -hex 32)"
	fi
	sed "s/@SEARXNG_SECRET_KEY@/${SECRET_KEY}/g" "$TEMPLATE_SETTINGS" > "$SEARXNG_SETTINGS"
	chmod 644 "$SEARXNG_SETTINGS"
elif [[ ! -f "$SEARXNG_SETTINGS" ]]; then
	SECRET_KEY="$(openssl rand -hex 32)"
	cat <<EOF >"$SEARXNG_SETTINGS"
# SearXNG configuration for Agent Mesh & NOMAD
use_default_settings: true

general:
  debug: false
  instance_name: "Agent Mesh SearXNG"

server:
  secret_key: "${SECRET_KEY}"
  bind_address: "0.0.0.0"
  port: 8080
  limiter: false
  image_proxy: true

search:
  safe_search: 0
  autocomplete: ""
  formats:
    - html
    - json

redis:
  url: redis://redis:6379/1
EOF
	chmod 644 "$SEARXNG_SETTINGS"
fi

# 2. Vane (Perplexica) Configuration
mkdir -p "$VANE_DIR/data" "$VANE_DIR/uploads"
VANE_CONFIG="$VANE_DIR/data/config.json"
if [[ ! -f "$VANE_CONFIG" ]]; then
	cat <<EOF >"$VANE_CONFIG"
{
  "version": 1,
  "setupComplete": true,
  "preferences": {},
  "personalization": {},
  "modelProviders": [
    {
      "id": "371a6b09-d866-4c04-a398-3d612f2fda6b",
      "name": "Transformers",
      "type": "transformers",
      "chatModels": [],
      "embeddingModels": [],
      "config": {
        "name": "Transformers"
      },
      "hash": "44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a"
    },
    {
      "id": "6af46cb0-a98a-415f-999d-6e24cb4eebfb",
      "name": "NOMAD-Ollama-GPU",
      "type": "ollama",
      "config": {
        "baseURL": "http://ollama:11434"
      },
      "chatModels": [],
      "embeddingModels": [],
      "hash": "bd39b6ac7fca1a24f55ccdae5d8c118fbc8259c5358c38be976f962f4b9f679c"
    }
  ],
  "search": {
    "searxngURL": "http://searxng:8080"
  }
}
EOF
	chmod 644 "$VANE_CONFIG"
fi

