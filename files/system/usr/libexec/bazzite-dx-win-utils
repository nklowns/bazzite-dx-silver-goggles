#!/usr/bin/env bash
# ==============================================================================
# bazzite-dx-win-utils: Windows Guest Utility Suite (Bazzite-DX)
# Links, downloads (via quickget) and snippets for high-performance Windows VMs
# ==============================================================================
set -euo pipefail

green="${green:-}"
yellow="${yellow:-}"
bold="${bold:-}"
normal="${normal:-}"

Choose() { :; }
# shellcheck disable=SC1091
if [[ -f /usr/lib/ujust/ujust.sh ]]; then
	source /usr/lib/ujust/ujust.sh
fi

COMMAND="${1:-}"

if [[ -z "$COMMAND" ]]; then
	echo "${bold}🪟 Windows Guest Utility Suite (Bazzite-DX)${normal}"
	echo "Tools and snippets for high-performance Windows VMs on Dell G15 (KVM / Looking Glass)."
	echo "----------------------------------------------------------------------"

	OPTION=$(
		Choose \
			"Download Windows 11 ISO (via quickget)" \
			"Download VirtIO Drivers (ISO)" \
			"Download Looking Glass B7 Host (Windows)" \
			"Install Looking Glass B7 Client Info (Host)" \
			"Download Virtual Display Driver (Idd)" \
			"Show Libvirt XML Snippets"
	)
else
	OPTION="$COMMAND"
fi

case "$OPTION" in
*"Windows 11"|windows-fetch)
	echo "=== Downloading Windows 11 via quickget ==="
	quickget windows 11
	;;

*"VirtIO"|virtio)
	echo "Opening download link for latest stable VirtIO drivers..."
	echo "Link: https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/latest-virtio/virtio-win.iso"
	xdg-open "https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/latest-virtio/virtio-win.iso" 2>/dev/null || true
	;;

*"Looking Glass B7 Host"|looking-glass-host)
	echo "Opening Looking Glass B7 Host Setup download..."
	echo "Note: Ensure you download the 'Host' version for Windows."
	echo "Link: https://looking-glass.io/downloads"
	xdg-open "https://looking-glass.io/downloads" 2>/dev/null || true
	;;

*"Looking Glass B7 Client"|looking-glass-client)
	echo "${bold}Looking Glass Client Status:${normal}"
	echo "Looking Glass Client is ${green}pre-installed${normal} directly in the Bazzite-DX Silver Goggles system image!"
	echo "To launch the client: looking-glass-client"
	echo "Use ${bold}Scroll Lock${normal} to capture and release mouse/keyboard input."
	;;

*"Virtual Display"|idd)
	echo "Opening IddSampleDriver (Virtual Display) repository..."
	echo "Link: https://github.com/ge9/IddSampleDriver/releases"
	xdg-open "https://github.com/ge9/IddSampleDriver/releases" 2>/dev/null || true
	;;

*"XML Snippets"|snippets)
	echo "${bold}1. IVSHMEM (Looking Glass / KVMFR)${normal}"
	echo "<shmem name='looking-glass'><model type='ivshmem-plain'/><size unit='M'>128</size></shmem>"
	echo ""
	echo "${bold}2. CPU Passthrough (Windows-optimized)${normal}"
	echo "<cpu mode='host-passthrough' check='none' migratable='off'>"
	echo "  <topology sockets='1' cores='4' threads='2'/>"
	echo "  <feature policy='require' name='invtsc'/>"
	echo "  <cache mode='passthrough'/>"
	echo "</cpu>"
	;;

*)
	echo "Usage: bazzite-dx-win-utils [windows-fetch|virtio|looking-glass-host|looking-glass-client|idd|snippets]"
	exit 1
	;;
esac
