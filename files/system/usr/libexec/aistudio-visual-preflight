#!/usr/bin/env bash
# aistudio-visual-preflight — ComfyUI dependency drift detector & auto-healer
#
# Runs as ExecStartPre= in aistudio-visual.service (via the quadlet [Service] section).
# Strategy: attempt to import the ComfyUI entry-point module chain inside a short-lived
# ephemeral container with the same image + volumes as the real service.  If any import
# fails due to a ModuleNotFoundError, pip-upgrade the offending package into the persistent
# site-packages SSD volume, then exit 0 so systemd continues to the main container.
#
# Design constraints obeyed:
#   - Zero pip installs on healthy boots (fast path exits in < 1 s after the import succeeds).
#   - Never touches torch/nvidia/cuda packages (they live in the image, not the volume).
#   - Idempotent: safe to run on every start; no state is written outside site-packages.
#   - ShellCheck-clean; set -euo pipefail throughout.
#
# Called by: aistudio-visual.container  [Service] ExecStartPre=
# Image ref is passed as $1 so the quadlet stays the single source of truth for the digest.

set -euo pipefail

IMAGE="${1:?aistudio-visual-preflight: IMAGE argument required}"
SITE_PKG="/var/srv/visual/site-packages"
COMFYUI_DIR="/var/srv/visual/ComfyUI"
MAX_ATTEMPTS=3
MAX_PREFLIGHT_SECS=30

# Packages that must NEVER be upgraded into the volume (provided by the base image).
BLOCKED_PKGS=("torch" "torchvision" "torchaudio" "functorch")
# nvidia/ cuda: exact match only — pip packages like nvidia-cuda-cupti are NOT blocked.
BLOCKED_EXACT=("nvidia" "cuda")

log() { echo "[preflight] $*"; }
warn() { echo "[preflight] ⚠  $*" >&2; }

# ---------------------------------------------------------------------------
# fast_check — try the critical import chain inside an ephemeral container.
# Returns 0 if all imports succeed, 1 otherwise; prints the offending module
# name on stdout so the caller can pip-install it.
# ---------------------------------------------------------------------------
fast_check() {
	local out
	out=$(podman run --rm \
		--env PYTHONPATH=/root/.local/lib/python3.12/site-packages \
		--env PYTHONUSERBASE=/root/.local \
		--volume "${SITE_PKG}:/root/.local/lib/python3.12/site-packages:Z" \
		--volume "${COMFYUI_DIR}:/root/ComfyUI:Z" \
		--workdir /root/ComfyUI \
		"${IMAGE}" \
		python3 -c "
import sys, importlib
sys.path.insert(0, '/root/ComfyUI')
modules = ['comfy.utils', 'comfy.storage', 'comfy.model_management']
for m in modules:
    try:
        importlib.import_module(m)
    except ModuleNotFoundError as e:
        # Print only the top-level package name that is missing.
        missing = str(e).split(\"'\")[1].split('.')[0] if \"'\" in str(e) else str(e)
        print(missing)
        sys.exit(1)
" 2>/dev/null) && return 0

	# out contains the missing top-level package name
	echo "${out}"
	return 1
}

# ---------------------------------------------------------------------------
# is_blocked — returns 0 (true) if the package name is blocked.
#
# torch/torchvision/torchaudio/functorch use prefix match.
# nvidia and cuda use exact match: pip packages like nvidia-cuda-cupti or
# cuda-python are NOT blocked — they live in the image but are installable via pip.
# ---------------------------------------------------------------------------
is_blocked() {
	local pkg="${1,,}" # lowercase

	# Exact-match packages: nvidia and cuda (pip-installable sub-packages OK)
	for exact in "${BLOCKED_EXACT[@]}"; do
		[[ "${pkg}" == "${exact}" ]] && return 0
	done

	# Prefix-match: torch, torchvision, torchaudio, functorch
	for prefix in "${BLOCKED_PKGS[@]}"; do
		[[ "${pkg}" == "${prefix}"* ]] && return 0
	done

	return 1
}

# ---------------------------------------------------------------------------
# pip_upgrade — install/upgrade a package into the persistent SSD volume.
# ---------------------------------------------------------------------------
pip_upgrade() {
	local pkg="$1"
	log "Upgrading '${pkg}' into ${SITE_PKG}…"
	podman run --rm \
		--env PIP_TARGET=/root/.local/lib/python3.12/site-packages \
		--volume "${SITE_PKG}:/root/.local/lib/python3.12/site-packages:Z" \
		"${IMAGE}" \
		pip install --upgrade --quiet --no-warn-script-location \
		--target /root/.local/lib/python3.12/site-packages \
		"${pkg}"
	log "  ✔ '${pkg}' upgraded."
}

# ---------------------------------------------------------------------------
# Main loop — up to MAX_ATTEMPTS heal-and-retry cycles.
# Total preflight budget: MAX_PREFLIGHT_SECS seconds (default 30).
# ---------------------------------------------------------------------------
log "Starting ComfyUI dependency preflight…"

start_sec=$SECONDS
attempt=0
while ((attempt < MAX_ATTEMPTS)); do
	# Check preflight budget before each podman run
	elapsed=$((SECONDS - start_sec))
	if ((elapsed > MAX_PREFLIGHT_SECS)); then
		warn "Preflight budget exhausted (${elapsed}s / ${MAX_PREFLIGHT_SECS}s). Proceeding."
		break
	fi

	((attempt++))
	missing=$(fast_check) && break # all imports OK → done

	if [[ -z "${missing}" ]]; then
		warn "Import failed but could not identify the missing package. Proceeding anyway."
		break
	fi

	log "Attempt ${attempt}/${MAX_ATTEMPTS}: missing module top-level package = '${missing}'"

	if is_blocked "${missing}"; then
		warn "'${missing}' is a blocked package (image-resident). Skipping pip upgrade."
		warn "This may be a base-image mismatch. Start will proceed; ComfyUI may fail."
		break
	fi

	pip_upgrade "${missing}"
done

if ((attempt >= MAX_ATTEMPTS)); then
	warn "Reached max heal attempts (${MAX_ATTEMPTS}). Proceeding — ComfyUI may still fail."
fi

log "Preflight complete. Handing off to ComfyUI."
