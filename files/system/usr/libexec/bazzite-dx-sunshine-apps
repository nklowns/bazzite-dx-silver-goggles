#!/usr/bin/env bash
# ==============================================================================
# bazzite-dx-sunshine-apps: Declarative multi-monitor apps manager for Sunshine
# Preserves existing Notebook (eDP-1) & AOC (HDMI-A-1) apps
# ==============================================================================
set -euo pipefail

# Sunshine runs as the flatpak dev.lizardbyte.app.Sunshine (see /usr/lib/systemd/user/sunshine.service).
SUNSHINE_DIR="$HOME/.var/app/dev.lizardbyte.app.Sunshine/config/sunshine"
APPS_FILE="$SUNSHINE_DIR/apps.json"
SET_OUTPUT_SCRIPT="$SUNSHINE_DIR/set-output.sh"
WAKE_SCRIPT="$SUNSHINE_DIR/wake.sh"

mkdir -p "$SUNSHINE_DIR"

if [ ! -f "$APPS_FILE" ] || [ ! -s "$APPS_FILE" ]; then
	echo '{"env":null,"apps":[]}' >"$APPS_FILE"
fi

# Helpers run as prep commands inside the flatpak sandbox: host tools need flatpak-spawn --host
# (the app has org.freedesktop.Flatpak talk access). Both also work when Sunshine runs natively.
cat <<'EOF' >"$SET_OUTPUT_SCRIPT"
#!/bin/bash
# Switch Sunshine's captured output, then restart the service on the host.
CONF="$(dirname "$(readlink -f "$0")")/sunshine.conf"
NAME="$1"
CURRENT="$(grep '^output_name' "$CONF" 2>/dev/null | sed 's/^output_name *= *//')"
[ "$CURRENT" = "$NAME" ] && exit 0
sed -i '/^output_name/d' "$CONF"
[ -n "$NAME" ] && echo "output_name = ${NAME}" >> "$CONF"
H=(); [ -f /.flatpak-info ] && H=(flatpak-spawn --host)
nohup "${H[@]}" systemctl --user restart sunshine.service >/dev/null 2>&1 &
disown
exit 0
EOF
chmod +x "$SET_OUTPUT_SCRIPT"

cat <<'EOF' >"$WAKE_SCRIPT"
#!/bin/bash
# Global prep command: wake the panel (DPMS) before a stream starts.
H=(); [ -f /.flatpak-info ] && H=(flatpak-spawn --host)
"${H[@]}" env XDG_RUNTIME_DIR="/run/user/$(id -u)" WAYLAND_DISPLAY=wayland-0 kscreen-doctor --dpms on >/dev/null 2>&1 &
exit 0
EOF
chmod +x "$WAKE_SCRIPT"

# Construct valid JSON app objects using jq
AUTO_APP=$(jq -n --arg script "$SET_OUTPUT_SCRIPT" '{
  "auto-detach": true,
  "exclude-global-prep-cmd": false,
  "exit-timeout": 5,
  "image-path": "desktop-alt.png",
  "name": "Desktop (Auto)",
  "wait-all": true,
  "prep-cmd": [{"do": $script, "undo": ""}]
}')

NOTEBOOK_APP=$(jq -n --arg path "$SUNSHINE_DIR/notebook.png" --arg script "$SET_OUTPUT_SCRIPT eDP-1" '{
  "auto-detach": true,
  "exclude-global-prep-cmd": false,
  "exit-timeout": 5,
  "image-path": $path,
  "name": "Notebook (eDP)",
  "wait-all": true,
  "prep-cmd": [{"do": $script, "undo": ""}]
}')

AOC_APP=$(jq -n --arg path "$SUNSHINE_DIR/aoc.png" --arg script "$SET_OUTPUT_SCRIPT HDMI-A-1" '{
  "auto-detach": true,
  "exclude-global-prep-cmd": false,
  "exit-timeout": 5,
  "image-path": $path,
  "name": "AOC (HDMI)",
  "wait-all": true,
  "prep-cmd": [{"do": $script, "undo": ""}]
}')

TMP_FILE=$(mktemp -p "$SUNSHINE_DIR" .apps.json.XXXXXX)

jq --argjson auto "$AUTO_APP" \
	--argjson nb "$NOTEBOOK_APP" \
	--argjson aoc "$AOC_APP" '
  .apps = ([$auto] + ((.apps // []) | map(select(.name != "Desktop (Auto)" and .name != "Notebook (eDP)" and .name != "AOC (HDMI)" and .name != "Dual Canvas (32:9)"))) + [$nb, $aoc])
' "$APPS_FILE" >"$TMP_FILE"

mv "$TMP_FILE" "$APPS_FILE"
echo "✅ Sunshine multi-monitor applications provisioned in $APPS_FILE"
