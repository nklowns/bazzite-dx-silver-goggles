[Unit]
Description=Remote Desktop Display Hotplug Watcher (restarts Sunshine & RustDesk on monitor change)
Documentation=https://github.com/nklowns/bazzite-dx-silver-goggles
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/libexec/bazzite-dx-remote-display-watcher
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
