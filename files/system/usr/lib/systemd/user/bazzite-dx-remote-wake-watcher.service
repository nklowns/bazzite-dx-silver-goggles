[Unit]
Description=Remote Desktop Display Wake Watcher (RustDesk & Sunshine DPMS Wake)
Documentation=https://github.com/nklowns/bazzite-dx-silver-goggles
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/libexec/bazzite-dx-remote-wake-watcher
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
