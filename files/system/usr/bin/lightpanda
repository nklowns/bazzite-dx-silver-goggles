#!/usr/bin/env bash
# ==============================================================================
# lightpanda: Host overlay wrapper for Lightpanda Headless Browser (:9225)
# Lifecycle (up/down/status) delegates to /usr/libexec/dx-svc.
# ==============================================================================
set -euo pipefail

DX_SVC="/usr/libexec/dx-svc"
[[ -x "$DX_SVC" ]] || DX_SVC="$(dirname "$0")/../libexec/dx-svc"

cmd="${1:-}"

case "$cmd" in
up | down | status | restart | logs)
	exec "$DX_SVC" "$cmd" lightpanda
	;;
serve)
	shift
	if command -v /home/linuxbrew/.linuxbrew/bin/lightpanda >/dev/null 2>&1; then
		exec /home/linuxbrew/.linuxbrew/bin/lightpanda serve --host 127.0.0.1 --port 9225 "$@"
	else
		exec podman run --rm -it -p 127.0.0.1:9225:9225 docker.io/lightpanda/browser:nightly /bin/lightpanda serve --host 0.0.0.0 --port 9225 "$@"
	fi
	;;
*)
	if [[ $# -eq 0 ]]; then
		echo "Uso: lightpanda [up|down|status|restart|logs|serve|fetch|dump] [opções]"
		echo "Exemplo: lightpanda fetch --dump markdown https://example.com"
		exit 0
	fi
	if command -v /home/linuxbrew/.linuxbrew/bin/lightpanda >/dev/null 2>&1; then
		exec /home/linuxbrew/.linuxbrew/bin/lightpanda "$@"
	else
		exec podman run --rm -i --network host docker.io/lightpanda/browser:nightly /bin/lightpanda "$@"
	fi
	;;
esac
