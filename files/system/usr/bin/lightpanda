#!/usr/bin/env bash
# ==============================================================================
# lightpanda: Host overlay wrapper for Lightpanda Headless Browser
# Runtime contract: os-fedora-silverblue.md §8 (Fixed Port 9225)
# ==============================================================================
set -euo pipefail

cmd="${1:-}"

case "$cmd" in
up)
	systemctl --user daemon-reload
	systemctl --user start lightpanda.service
	echo "✅ Lightpanda CDP server ativo em ws://127.0.0.1:9225"
	echo "   Endpoint HTTP: http://127.0.0.1:9225/json/version"
	;;
down)
	systemctl --user stop lightpanda.service
	echo "🛑 Lightpanda CDP server parado."
	;;
status)
	STATE=$(systemctl --user is-active lightpanda.service 2>/dev/null || true)
	printf "%-16s %s\n" "lightpanda:" "${STATE:-inactive}"
	if ss -tln 2>/dev/null | grep -q ':9225 '; then
		echo "  Porta 9225: ABERTA (ws://127.0.0.1:9225)"
	else
		echo "  Porta 9225: fechada"
	fi
	;;
serve)
	shift
	if command -v /home/linuxbrew/.linuxbrew/bin/lightpanda >/dev/null 2>&1; then
		exec /home/linuxbrew/.linuxbrew/bin/lightpanda serve --host 127.0.0.1 --port 9225 "$@"
	else
		exec podman run --rm -it -p 127.0.0.1:9225:9225 docker.io/lightpanda/browser:nightly /bin/lightpanda serve --host 0.0.0.0 --port 9225 "$@"
	fi
	;;
*)
	if [[ $# -eq 0 ]]; then
		echo "Uso: lightpanda [up|down|status|serve|fetch|dump] [opções]"
		echo "Exemplo: lightpanda fetch --dump markdown https://example.com"
		exit 0
	fi
	if command -v /home/linuxbrew/.linuxbrew/bin/lightpanda >/dev/null 2>&1; then
		exec /home/linuxbrew/.linuxbrew/bin/lightpanda "$@"
	else
		exec podman run --rm -i docker.io/lightpanda/browser:nightly /bin/lightpanda "$@"
	fi
	;;
esac
