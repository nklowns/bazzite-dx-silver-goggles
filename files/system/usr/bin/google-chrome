#!/bin/sh
# Chrome enforces a non-default --user-data-dir before it will open the CDP
# port, so debugging is opt-in via a dedicated automation profile rather than
# the personal signed-in profile (CDP on that profile = session hijack risk).
exec /usr/bin/flatpak run --branch=stable --arch=x86_64 com.google.Chrome \
  --remote-debugging-port=9222 \
  --user-data-dir="$HOME/.config/google-chrome-cdp" \
  "$@"
