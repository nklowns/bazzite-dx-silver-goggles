#!/usr/bin/env bash
# /usr/bin/ai-vram-purge — Free 100% of GPU VRAM by stopping all GPU Quadlets.
# Delegates to /usr/libexec/dx-svc (single source of truth for AddDevice=nvidia.com/gpu).
set -uo pipefail

DX_SVC="/usr/libexec/dx-svc"
if [[ ! -x "$DX_SVC" && -x "$(dirname "$0")/../libexec/dx-svc" ]]; then
	DX_SVC="$(dirname "$0")/../libexec/dx-svc"
fi

if [[ -x "$DX_SVC" ]]; then
	exec "$DX_SVC" down gpu
fi

# Fallback if invoked outside an image carrying dx-svc
for u in aistudio-visual aistudio-audio nomad-llama; do
	systemctl --user stop "${u}.service" 2>/dev/null || true
done
echo "✅ VRAM liberada." >&2
