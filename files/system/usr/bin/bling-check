#!/usr/bin/bash
# Silver Goggles: Shell Experience Audit
# Checks bling infrastructure, Homebrew PATH, tools, and toggle states.
# Usage: bling-check  |  ujust bling-check

set -uo pipefail

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'
OK="${GREEN}[ OK ]${NC}"
FAIL="${RED}[FAIL]${NC}"
WARN="${YELLOW}[WARN]${NC}"
OFF="${YELLOW}[ -- ]${NC}"

printf "\n%b=== Silver Goggles: Shell Experience ===%b\n" "${BLUE}" "${NC}"
printf "%bVersion: %b%s%b\n" "${BLUE}" "${YELLOW}" "${DX_VERSION:-unknown}" "${NC}"

# --- 1. Infrastructure ---
printf "\n%b1. Infrastructure%b\n" "${BLUE}" "${NC}"

_check_file() {
	local label="$1" path="$2" severity="${3:-FAIL}"
	if [[ -f "$path" ]]; then
		printf "   %b %s\n" "$OK" "$label"
	elif [[ "$severity" == "WARN" ]]; then
		printf "   %b %s — missing (%s)\n" "$WARN" "$label" "$path"
	else
		printf "   %b %s — missing (%s)\n" "$FAIL" "$label" "$path"
	fi
}

_check_file "Homebrew init (sh)   " /etc/profile.d/brew.sh
_check_file "Homebrew completion (sh)" /etc/profile.d/brew-bash-completion.sh
_check_file "DX Env Hook (sh)     " /usr/share/ublue-os/user-setup.hooks.d/40-bazzite-dx-env.sh
_check_file "Homebrew init (fish) " /usr/share/fish/vendor_conf.d/ublue-brew.fish WARN
_check_file "Bling wrapper (sh)  " /etc/profile.d/zz-bazzite-dx-bling.sh
_check_file "bling.sh            " /usr/share/ublue-os/silver-goggles/bling.sh
_check_file "Bling wrapper (fish)" /usr/share/fish/vendor_conf.d/zz-bazzite-dx-bling.fish WARN
_check_file "bling.fish          " /usr/share/ublue-os/silver-goggles/bling.fish WARN

if rpm -q bash-preexec &>/dev/null; then
	printf "   %b bash-preexec       rpm:%s\n" "$OK" "$(rpm -q bash-preexec --qf '%{VERSION}')"
elif [[ -f "${HOMEBREW_PREFIX:-}/etc/profile.d/bash-preexec.sh" ]]; then
	printf "   %b bash-preexec       brew:%s\n" "$OK" "${HOMEBREW_PREFIX}/etc/profile.d/bash-preexec.sh"
else
	printf "   %b bash-preexec       — not found (run: ujust setup-default-brew cli)\n" "$WARN"
fi

# --- 2. Homebrew ---
printf "\n%b2. Homebrew%b\n" "${BLUE}" "${NC}"
# brew.sh has an interactive guard — call brew directly for non-interactive diagnostics
_BREW_BIN="/home/linuxbrew/.linuxbrew/bin/brew"
if [[ -x "$_BREW_BIN" ]]; then
	eval "$($_BREW_BIN shellenv)" 2>/dev/null || true
fi
unset _BREW_BIN

if [[ -n "${HOMEBREW_PREFIX:-}" ]]; then
	printf "   %b HOMEBREW_PREFIX=%s\n" "$OK" "${HOMEBREW_PREFIX}"
else
	printf "   %b Homebrew not initialized — run brew setup first\n" "$FAIL"
fi

# --- 3. Tools ---
printf "\n%b3. Tools%b\n" "${BLUE}" "${NC}"
declare -A TOOL_BINS=(
	[mise]=mise [atuin]=atuin [starship]=starship
	[zoxide]=zoxide [direnv]=direnv [eza]=eza [bat]=bat [ugrep]=ugrep
	[k9s]=k9s [helm]=helm [topgrade]=topgrade [fzf]=fzf
)
for tool in mise atuin starship zoxide direnv eza bat ugrep k9s helm topgrade fzf; do
	bin="${TOOL_BINS[$tool]}"
	if path=$(command -v "$bin" 2>/dev/null); then
		printf "   %b %s (%s)\n" "$OK" "$tool" "$path"
	else
		printf "   %b %s — not found (install via Brewfile)\n" "$FAIL" "$tool"
	fi
done

# --- 4. Toggles ---
printf "\n%b4. Toggles%b\n" "${BLUE}" "${NC}"
for t in EZA UGREP BAT ATUIN STARSHIP ZOXIDE MISE DIRENV FZF K8S; do
	var="BLUEFIN_SHELL_ENABLE_${t}"
	val="${!var:-1}"
	if [[ "$val" == "0" ]]; then
		printf "   %b %s=0  (disabled)\n" "$OFF" "$var"
	else
		printf "   %b %s=%s\n" "$OK" "$var" "${!var:-1 (default)}"
	fi
done

# --- 5. Environment ---
printf "\n%b5. Environment%b\n" "${BLUE}" "${NC}"
printf "   %b EDITOR=%s\n" "$OK" "${EDITOR:-not set}"
printf "   %b PAGER=%s\n" "$OK" "${PAGER:-not set}"

if [[ ":$PATH:" == *":$HOME/.local/share/mise/shims:"* ]]; then
	printf "   %b Mise shims in PATH\n" "$OK"
else
	printf "   %b Mise shims NOT in PATH\n" "$WARN"
fi

# --- 6. Flatpak Atomic Integrity ---
printf "\n%b6. Flatpak Overrides (Atomic Integrity)%b\n" "${BLUE}" "${NC}"
OVERRIDE_SRC="/usr/share/flatpak/overrides"
OVERRIDE_DST="/var/lib/flatpak/overrides"

if [[ -d "$OVERRIDE_SRC" ]]; then
	for src in "$OVERRIDE_SRC"/*; do
		app=$(basename "$src")
		dst="$OVERRIDE_DST/$app"

		if [[ -L "$dst" ]]; then
			target=$(readlink -f "$dst")
			if [[ "$target" == "$src" ]]; then
				printf "   %b %s -> %s\n" "$OK" "$app" "Linked correctly"
			else
				printf "   %b %s -> %bDRIFT%b (Points to: %s)\n" "$FAIL" "$app" "${RED}" "${NC}" "$target"
			fi
		elif [[ -f "$dst" ]]; then
			printf "   %b %s -> %bSHADOWED%b (Regular file in /var)\n" "$FAIL" "$app" "${RED}" "${NC}"
		else
			printf "   %b %s -> %bMISSING%b (Run tmpfiles setup)\n" "$FAIL" "$app" "${RED}" "${NC}"
		fi
	done
else
	printf "   %b No overrides found in image\n" "$WARN"
fi

printf "\n"
