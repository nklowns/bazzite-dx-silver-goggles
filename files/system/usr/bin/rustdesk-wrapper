#!/usr/bin/env bash
# ==============================================================================
# Single-Instance Launcher Wrapper for RustDesk Remote Desktop
# Prevents spawning duplicate Flatpak containers and restores UI window when clicked.
# ==============================================================================
set -euo pipefail

# Check if RustDesk process or systemd service is active
if pgrep -f "com.rustdesk.RustDesk" >/dev/null 2>&1 || pgrep -x "rustdesk" >/dev/null 2>&1; then
	# Restore / un-minimize window if already running
	python3 -c "
import subprocess, shutil
qdbus = 'qdbus-qt6' if shutil.which('qdbus-qt6') else 'qdbus'
script = '''
var clients = (typeof workspace.windowList === 'function') ? workspace.windowList() : workspace.stackingOrder;
for (var i = 0; i < clients.length; i++) {
    var c = clients[i];
    var cap = (c.caption || '').toLowerCase();
    var cls = (c.resourceClass || '').toLowerCase();
    if (cap.indexOf('rustdesk') !== -1 || cls.indexOf('rustdesk') !== -1) {
        c.minimized = false;
        workspace.activeWindow = c;
    }
}
'''
with open('/tmp/kwin_restore_rustdesk.js', 'w') as f:
    f.write(script)
try:
    res = subprocess.check_output([qdbus, 'org.kde.KWin', '/Scripting', 'org.kde.kwin.Scripting.loadScript', '/tmp/kwin_restore_rustdesk.js'], stderr=subprocess.DEVNULL, text=True).strip()
    if res.isdigit():
        subprocess.call([qdbus, 'org.kde.KWin', f'/Scripting/Script{res}', 'run'], stderr=subprocess.DEVNULL)
        subprocess.call([qdbus, 'org.kde.KWin', f'/Scripting/Script{res}', 'stop'], stderr=subprocess.DEVNULL)
        subprocess.call([qdbus, 'org.kde.KWin', '/Scripting', 'org.kde.kwin.Scripting.unloadScript', res], stderr=subprocess.DEVNULL)
except Exception:
    pass
" 2>/dev/null || true

	if command -v notify-send >/dev/null 2>&1; then
		notify-send --app-name="RustDesk" --icon="com.rustdesk.RustDesk" "RustDesk" "Restaurando janela da bandeja do sistema (systray)." 2>/dev/null || true
	fi
	exit 0
fi

# Ensure allow-hide-cm is enabled in RustDesk2.toml (prevents leaking orphaned --cm processes).
# Lives here rather than a run-once login hook because RustDesk2.toml only exists after first launch.
RUSTDESK_CONF="$HOME/.var/app/com.rustdesk.RustDesk/config/rustdesk/RustDesk2.toml"
if [ -f "$RUSTDESK_CONF" ] && ! grep -q '^allow-hide-cm' "$RUSTDESK_CONF" 2>/dev/null; then
	if grep -q '^\[options\]' "$RUSTDESK_CONF" 2>/dev/null; then
		sed -i "/^\[options\]/a allow-hide-cm = 'Y'" "$RUSTDESK_CONF" 2>/dev/null || true
	fi
fi

if systemctl --user is-enabled rustdesk.service >/dev/null 2>&1; then
	exec systemctl --user start rustdesk.service
else
	exec /usr/bin/flatpak run com.rustdesk.RustDesk "$@"
fi
