#!/usr/bin/env bash
# ==============================================================================
# remote-suite: Master CLI manager for Silver-Goggles Remote Access Suite
# ==============================================================================
set -euo pipefail

action="${1:-status}"

case "$action" in
    status)
        echo "======================================================================"
        echo " 🛡️ SILVER-GOGGLES REMOTE ACCESS SUITE STATUS"
        echo "======================================================================"
        echo ""
        echo "1. 🎮 Sunshine (NVENC Streaming / Moonlight)"
        if systemctl --user is-active --quiet homebrew.sunshine.service 2>/dev/null; then
            echo "   Status: ✅ ACTIVE (Port 47989 / Web UI 61395)"
        else
            echo "   Status: ❌ INACTIVE (Start with: systemctl --user start homebrew.sunshine.service)"
        fi
        echo ""
        echo "2. 🌐 Apache Guacamole + KRDP (HTML5 Client - Note: KRDP unstable on Wayland/NVIDIA bazzite#2173)"
        if ss -tln 2>/dev/null | grep -q ':61392 '; then
            echo "   Status: ✅ ACTIVE (Port 61392)"
        else
            echo "   Status: ⚪ INACTIVE (Setup with: ujust remote-guacamole-setup)"
        fi
        echo ""
        echo "3. 🎥 Webcam Bridge (Windows RTSP -> /dev/video10)"
        if [ -c /dev/video10 ]; then
            echo "   Status: ✅ /dev/video10 ACTIVE (Ready for Google Meet / Teams)"
        else
            echo "   Status: ⚪ INACTIVE (Start receiver: ujust remote-webcam-setup)"
        fi
        echo ""
        echo "4. 🎙️ PipeWire Microphone Receiver"
        if [ -f "$HOME/.config/pipewire/pipewire.conf.d/rtp-source.conf" ]; then
            echo "   Status: ✅ PipeWire RTP Source Configured"
        else
            echo "   Status: ⚪ Standard PipeWire Audio"
        fi
        echo ""
        echo "5. 🎯 Additional Tools (Client & Input Utilities)"
        if flatpak info com.parsec.app >/dev/null 2>&1; then
            echo "   Parsec:   ✅ INSTALLED (Client-only: Use to access Windows hosts from Bazzite)"
        else
            echo "   Parsec:   ⚪ ABSENT (Setup with: ujust remote-parsec-setup)"
        fi
        if flatpak info com.rustdesk.RustDesk >/dev/null 2>&1; then
            echo "   RustDesk: ✅ INSTALLED (Direct IP via Tailnet - Requires Wayland portal prompt)"
        else
            echo "   RustDesk: ⚪ ABSENT (Setup with: ujust remote-rustdesk-setup)"
        fi
        if flatpak info com.deskflow.deskflow >/dev/null 2>&1; then
            echo "   Deskflow: ✅ INSTALLED (Software KVM input sharing via Tailscale :24800)"
        else
            echo "   Deskflow: ⚪ ABSENT (Setup with: ujust remote-deskflow-setup)"
        fi
        echo ""
        echo "6. 📁 File Transfer & Mesh Network (Tailscale)"
        if command -v tailscale >/dev/null && tailscale status >/dev/null 2>&1; then
            DNS_NAME=$(tailscale status --self --json | jq -r '.Self.DNSName' | sed 's/\.$//')
            TS_IP=$(tailscale ip -4 2>/dev/null | head -1)
            echo "   Tailscale: ✅ CONNECTED ($DNS_NAME / $TS_IP)"
            echo "   Taildrop:  ✅ READY (Send files to $DNS_NAME via Tailscale)"
        else
            echo "   Tailscale: ❌ NOT CONNECTED"
        fi
        echo "======================================================================"
        ;;
    setup-mic)
        echo "🎙️ Provisioning PipeWire RTP Microphone receiver..."
        mkdir -p "$HOME/.config/pipewire/pipewire.conf.d"
        cat << 'EOF' > "$HOME/.config/pipewire/pipewire.conf.d/rtp-source.conf"
context.modules = [
    {
        name = libpipewire-module-rtp-source
        args = {
            sess.latency.msec = 40
            source.ip = "0.0.0.0"
            source.port = 46000
        }
    }
]
EOF
        systemctl --user restart pipewire
        echo "✅ PipeWire RTP Microphone receiver active on port 46000 UDP."
        ;;
    *)
        echo "Usage: remote-suite [status|setup-mic]"
        exit 1
        ;;
esac
