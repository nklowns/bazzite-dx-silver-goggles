#!/usr/bin/env bash
# Runs inside the comfyui-boot container to extract base-image Requires-Dist upper bounds,
# merge optional /constraints.txt, and execute `uv pip install` against /target.
set -euo pipefail

python3.13 -c '
import importlib.metadata as m
from packaging.markers import default_environment
from packaging.requirements import Requirement

env = default_environment()
skip = ("comfy", "torch", "nvidia", "triton", "cuda")
with open("/tmp/effective-constraints.txt", "w") as f:
    for d in m.distributions():
        if d.metadata["Name"].lower().startswith(skip):
            continue
        for raw in (d.requires or []):
            req = Requirement(raw)
            if req.marker and not req.marker.evaluate(env):
                continue
            if req.name.lower().startswith(skip):
                continue
            if any(s.operator in ("<", "<=", "~=") for s in req.specifier):
                f.write(f"{req.name}{req.specifier}\n")
'

if [[ -f /constraints.txt ]]; then
	cat /constraints.txt >>/tmp/effective-constraints.txt
fi

exec uv pip install \
	--python /usr/bin/python3.13 \
	--target /target \
	--quiet \
	--constraints /tmp/effective-constraints.txt \
	"$@"
