[Context]
filesystems=home;xdg-download;xdg-desktop;xdg-documents;

[Session Bus Policy]
org.freedesktop.portal.Desktop=talk
org.freedesktop.portal.Documents=talk

[Environment]
EDGE_EXTRA_FLAGS=--ozone-platform-hint=auto --enable-features=TouchpadOverscrollHistoryNavigation,WaylandWindowDecorations --disable-gpu-compositing
