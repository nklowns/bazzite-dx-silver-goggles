# ==============================================================================
# Recoll Configuration Template — Bazzite Agent Mesh & Project NOMAD
# ==============================================================================
# Whitelist of top directories to index (inside the container namespaces)
topdirs = /export/documents

# Database path (mounted to persistent storage /var/srv/recoll/xapiandb)
dbdir = /var/recoll/db

# Whitelist / Exclusion patterns for developer trees, caches, containers, and binary files
skippedNames = node_modules .git .svn .hg target build dist .venv venv __pycache__ \
               .cache Cache Cache_Data "Code Cache" GPUCache .npm .yarn .pnpm-store \
               .cargo .rustup .gradle .m2 .nuget .gem .bundle .pip .tox .mypy_cache \
               .pytest_cache .ruff_cache .next .nuxt .turbo .vite distrobox containers \
               .wine .flatpak .var .local .config .thumbnails .cache* \
               *.env* *.key *.pem id_* id_rsa id_ed25519 *.kdbx *.age *.sops credentials.json token.json secrets.* \
               *.iso *.tar.gz *.tgz *.zip *.7z *.rar *.qcow2 *.vdi *.raw *.bin *.exe *.dll \
               *.so *.dylib *.o *.a *.pyc *.wasm *.png *.jpg *.jpeg *.gif *.webp *.svg *.ico \
               *.mp4 *.mkv *.avi *.webm *.mp3 *.flac *.wav *.ogg *.woff *.woff2 *.ttf *.eot


# Don't follow symlinks to avoid recursion outside whitelisted roots
followSymbolicLinks = 0

# Index tuning and limits
idxflushmb = 50
defaultCharset = UTF-8
