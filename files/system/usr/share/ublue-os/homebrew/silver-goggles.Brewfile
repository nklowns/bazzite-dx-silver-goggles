# Bazzite-DX: Silver-Goggles Personal Suite
# Class: "Personal Workspace, Productivity & Gaming"

# --- Communication & Social ---
flatpak "dev.vencord.Vesktop"                               # Enhanced Discord client
flatpak "us.zoom.Zoom"                                      # Video conferencing

# --- Entertainment & Media ---
flatpak "com.spotify.Client"                                # Music streaming
flatpak "com.obsproject.Studio"                             # Open Broadcaster Software
flatpak "org.qbittorrent.qBittorrent"                       # Torrent client

# --- Productivity & Notes ---
flatpak "md.obsidian.Obsidian"                              # Knowledge base / Markdown notes
flatpak "com.google.Chrome"                                 # Web browser

# --- Containers & Remote Access ---
flatpak "io.podman_desktop.PodmanDesktop"                   # Container desktop management (User-space GUI)
flatpak "com.rustdesk.RustDesk"                             # Open source remote desktop

# --- Gaming & Emulation ---
flatpak "net.retrodeck.retrodeck"                           # All-in-one emulation suite
flatpak "com.heroicgameslauncher.hgl"                       # Epic/GOG/Amazon games launcher
flatpak "io.github.Faugus.faugus-launcher"                  # Specialized game launcher
flatpak "io.github.unknownskl.greenlight"                   # Xbox Cloud Gaming/Cloud Stream
flatpak "io.github.elyprismlauncher.ElyPrismLauncher"       # Xbox Cloud Gaming/Cloud Stream
flatpak "org.vinegarhq.Sober"                               # Specialized game launcher

# --- Taps (Trusted Sources) ---
tap "ublue-os/tap"
tap "ublue-os/experimental-tap"

# --- Cloud Infrastructure & CLI Tools ---
brew "act"                                                  # Run GitHub Actions locally
brew "cosign"                                               # OCI artifact signing
brew "mise"                                                 # Multi-runtime manager
brew "opentofu"                                             # Open-source Terraform
brew "gh"                                                   # GitHub CLI
brew "libpq"                                                # Postgres client libs
cask "gcloud-cli"                                           # Google Cloud SDK

# --- Personal Workspace (Dotfiles & IDE) ---
brew "chezmoi"                                              # Personal dotfiles manager
cask "ublue-os/tap/antigravity-ide-linux"                   # Antigravity IDE
cask "ublue-os/tap/antigravity-cli-linux"                   # Antigravity CLI
cask "ublue-os/tap/visual-studio-code-linux"                # Visual Studio Code IDE
cask "ublue-os/tap/visual-studio-code-linux@insiders"       # Visual Studio Code Insiders IDE