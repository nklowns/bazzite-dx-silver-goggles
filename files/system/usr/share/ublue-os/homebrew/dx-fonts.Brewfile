# Bazzite-DX: Extra Developer Fonts (fonts)
# Additional coding fonts available via Homebrew Casks.
# This Brewfile provides specialized alternatives and Nerd Font variants.

# --- Google Fonts ---
cask "font-inter"
cask "font-outfit"

# --- Specialized Monospace Fonts ---
cask "font-cascadia-code"
cask "font-cascadia-code-pl"
cask "font-monaspace"
cask "font-noto-sans-symbols"
cask "font-victor-mono"
cask "font-recursive"

# --- Nerd Font Variants (Inspiration from Bluefin) ---
cask "font-caskaydia-mono-nerd-font"
cask "font-comic-shanns-mono-nerd-font"
cask "font-droid-sans-mono-nerd-font"
cask "font-go-mono-nerd-font"
cask "font-blex-mono-nerd-font"
cask "font-sauce-code-pro-nerd-font"
cask "font-ubuntu-nerd-font"
cask "font-0xproto-nerd-font"
cask "font-jetbrains-mono-nerd-font"
cask "font-fira-code-nerd-font"
cask "font-hack-nerd-font"
