# Bazzite-DX: Terminal Excellence (cli)
# Class: "Terminal Essentials & Data Ops"

# --- Taps (Trusted Sources) ---
tap "ublue-os/tap"
tap "ublue-os/experimental-tap"
tap "kernel/tap"                        # For Hypeman
tap "spinframework/tap"                 # For Spin
tap "supabase/tap"                      # For Supabase
tap "valkyrie00/bbrew"                  # For bbrew

# --- Shell Foundations ---
brew "bat"                              # Better cat with syntax highlighting
brew "bash-preexec"                     # Essential hooks for Bash history/direnv
brew "eza"                              # Modern ls alternative
brew "fzf"                              # Command-line fuzzy finder
brew "zoxide"                           # Smarter cd command
brew "tealdeer"                         # Fast tldr implementation
brew "starship"                         # The customizable cross-shell prompt
brew "atuin"                            # Magical shell history
brew "direnv"                           # Shell environment switcher
brew "mise"                             # Fast and flexible dependency manager
brew "nushell"                          # Nushell: A modern, structured shell
brew "yazi"                             # Yazi: High-performance async TUI file manager
brew "broot"                            # Broot: Interactive terminal directory navigator
brew "superfile"                        # Superfile: Sleek and beautiful terminal file manager TUI

# --- Core Processing ---
brew "dasel"                            # Query/update JSON, YAML, TOML, XML, CSV with one syntax
brew "jq"                               # JSON command-line processor
brew "jnv"                              # Interactive JSON filter and viewer companion to jq
brew "yq"                               # YAML command-line processor
brew "qsv"                              # Ultra-fast CSV analysis and manipulation
brew "miller"                           # Like sed/awk but for CSV, JSON, and tabular data
brew "duckdb"                           # Analytical SQL engine (OLAP)
brew "glow"                             # Terminal markdown renderer
brew "ripgrep"                          # Fast line-oriented search tool
brew "ugrep"                            # Ultra-fast grep with interactive TUI
brew "fd"                               # Simple, fast alternative to find
brew "fx"                               # Interactive JSON viewer (TUI companion to jq)
brew "choose-rust"                      # Choose: Human-friendly alternative to cut and awk
brew "trurl"                            # Trurl: URL parser and manipulator command line tool
brew "hexyl"                            # Hexyl: Colorized command-line hex viewer

# --- Data Ops, Backup & Transfer ---
brew "rclone"                           # Sync files to cloud storage
brew "restic"                           # Fast, secure and efficient backup program
brew "croc"                             # Fast and secure file transfer
brew "magic-wormhole.rs"                # Rust implementation of Magic Wormhole
brew "ouch"                             # Painless compression/decompression for all formats

# --- Network Debugging ---
# Essential tools for API and network troubleshooting.
brew "doggo"                            # DNS client for humans (dig replacement, successor to dog)
brew "gping"                            # Graphical ping tool visualizing latency
brew "httpie"                           # Modern, user-friendly CURL alternative
brew "xh"                               # Friendly and fast tool for sending HTTP requests in Rust
brew "hurl"                             # Run and test HTTP requests from simple plain text files
brew "curlie"                           # Power of curl, ease of httpie
brew "mtr"                              # Network diagnostic tool (ping + traceroute)
brew "viddy"                            # Modern watch command with history and coloring
flatpak "io.github.Archeb.opentrace"    # Visual network traceroute (GUI companion to mtr)
flatpak "io.github.tobagin.digger"      # Modern DNS client (GUI companion to doggo)
flatpak "org.wireshark.Wireshark"       # Wireshark: Network protocol analyzer GUI

# --- System & Monitor ---
brew "duf"                              # Disk Usage/Free utility
brew "dust"                             # Rust-based visual alternative to du
brew "btop"                             # Interactive system monitor
brew "kernel/tap/hypeman"               # VM: Docker-style micro-VM manager

# --- Editors & Knowledge Base ---
brew "micro"                            # Intuitive terminal editor
cask "ublue-os/experimental-tap/zed-linux"           # Zed: High-performance collaborative Rust editor
cask "ublue-os/experimental-tap/cursor-linux"        # Cursor: AI-first code editor
cask "ublue-os/tap/jetbrains-toolbox-linux"          # JetBrains Toolbox: Management of JetBrains IDEs
flatpak "md.obsidian.Obsidian"          # Knowledge: Second Brain / Markdown system

# --- Version Control & Collaboration ---
brew "gh"                               # GitHub CLI
brew "glab"                             # GitLab CLI
brew "act"                              # GitHub Actions CLI
brew "chezmoi"                          # Dotfiles manager
brew "jj"                               # Jujutsu: Version control for concurrent AI agents
brew "gitoxide"                         # Pure Rust Git implementation for high-speed VCS
cask "gitbutler"                        # AST-aware Git orchestration
brew "lazygit"                          # Lazygit: Keyboard-driven terminal UI for Git
brew "gitui"                            # Blazing fast terminal UI for Git in Rust
brew "git-delta"                        # Delta: Syntax-highlighting pager for git diffs
brew "onefetch"                         # Onefetch: Git repository information tool
flatpak "com.github.Murmele.Gittyup"    # Gittyup: Graphical Git client and history explorer

# --- Search & Developer Experience (DX) ---
brew "ast-grep"                         # Tree-sitter based semantic search
brew "sem-cli"                          # Semantic Diff: Binary for AST-based structural diffs
brew "difftastic"                       # Logic-based syntax diffing
flatpak "org.gnome.meld"                # Meld: Visual diff and merge tool
brew "shellcheck"                       # Linter for shell scripts
brew "shfmt"                            # Formatter for shell scripts (pairs with shellcheck)
brew "vale"                             # Documentation: The professional prose linter
brew "trash-cli"                        # Command-line interface to the freedesktop.org trashcan
brew "valkyrie00/bbrew/bbrew"           # Fast Brew search and preview

# --- Services & Platform CLIs ---
brew "spinframework/tap/spin"           # Spin: Wasm runtime (Framework)
brew "stripe-cli"                       # Stripe: Payment API CLI
brew "supabase/tap/supabase"            # Supabase: Data Operations CLI

# --- Hardware & Platform Utilities ---
cask "android-platform-tools"           # Mobile: ADB & Fastboot
brew "scrcpy"                           # Mobile: Android screen+audio mirroring (ADB; works over tailnet)
brew "cdrtools"                         # Media: ISO creation (provides genisoimage)
