{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  forkProcessing: 'enabled',
  dependencyDashboard: true,
  rebaseWhen: 'never',
  'git-submodules': {
    enabled: true,
  },
  customManagers: [
    {
      customType: 'regex',
      description: 'Track base-image tag and digest in image-versions.yaml',
      managerFilePatterns: [
        '/^image-versions\\.yaml$/',
      ],
      matchStrings: [
        'image:\\s+(?<depName>[^\\n]+)\\n\\s+tag:\\s+(?<currentValue>[^\\n]+)\\n\\s+digest:\\s+(?<currentDigest>sha256:[a-f0-9]+)',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
    },
    {
      customType: 'regex',
      description: 'Track Quadlet container image digests (Project NOMAD stack, Ollama)',
      // Pinned inline in the units rather than in image-versions.yaml: the unit is what
      // ships, so pinning it directly removes the render step and the chance of the two
      // copies disagreeing. Matches `Image=registry/path[:tag]@sha256:...` in any .container file.
      managerFilePatterns: [
        '/^files/system/etc/containers/systemd/users/.+\\.container$/',
      ],
      matchStrings: [
        'Image=(?<depName>[^\\s@:]+)(:(?<currentValue>[^@\\s]+))?@(?<currentDigest>sha256:[a-f0-9]+)',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
    },
    {
      customType: 'regex',
      description: 'Track image dependencies in Justfile',
      managerFilePatterns: [
        '/^Justfile$/',
      ],
      matchStrings: [
        '["\'](?<depName>fedora):(?<currentValue>[^"\']+)["\']',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
    },
  ],
  packageRules: [
    {
      description: 'Automatically automerge pin and pinDigest updates for all dependencies to maintain stability',
      matchUpdateTypes: [
        'pin',
        'pinDigest',
      ],
      automerge: true,
      ignoreTests: true,
    },
    {
      description: 'Disable automated container updates within GitHub workflows for security/drift prevention',
      enabled: false,
      matchUpdateTypes: [
        'digest',
        'pinDigest',
        'pin',
      ],
      matchDepTypes: [
        'container',
      ],
      matchFileNames: [
        '.github/workflows/**.yaml',
        '.github/workflows/**.yml',
      ],
    },
    {
      description: 'Automerge GitHub Actions digest updates in workflows for security parity',
      matchDatasources: [
        'github-tags',
      ],
      matchFileNames: [
        '.github/workflows/**',
      ],
      matchUpdateTypes: [
        'digest',
        'pinDigest',
      ],
      automerge: true,
      ignoreTests: true,
    },
    {
      description: 'Auto-update and automerge Bazzite-Nvidia base image digest in image-versions.yaml',
      matchFileNames: [
        'image-versions.yaml',
      ],
      matchUpdateTypes: [
        'digest',
        'pinDigest',
      ],
      matchPackageNames: [
        'ghcr.io/ublue-os/bazzite-nvidia',
      ],
      pinDigests: true,
      automerge: true,
      ignoreTests: true,
      commitMessagePrefix: 'chore(deps): ',
    },
    {
      description: 'Auto-update and automerge Project NOMAD stack image digests in the Quadlet units',
      // Scoped by path, not by package name: the stack is a moving target (Ollama joined it
      // when GPU work moved out of the Supply Depot, and Supply Depot apps may follow), and
      // an enumerated package list silently stops covering whatever gets added next.
      matchFileNames: [
        'files/system/etc/containers/systemd/users/*.container',
      ],
      matchUpdateTypes: [
        'digest',
        'pinDigest',
      ],
      pinDigests: true,
      automerge: true,
      ignoreTests: true,
      commitMessagePrefix: 'chore(deps-nomad): ',
    },
    {
      description: 'Disable pinDigests for Fedora builder stage to avoid registry mismatch',
      matchPackageNames: [
        'fedora',
      ],
      pinDigests: false,
    },
  ],
}
