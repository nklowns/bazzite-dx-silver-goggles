{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  forkProcessing: 'enabled',
  dependencyDashboard: true,
  rebaseWhen: 'never',
  'git-submodules': {
    enabled: true,
  },
  customManagers: [
    {
      customType: 'regex',
      description: 'Track base-image tag and digest in image-versions.yaml',
      managerFilePatterns: [
        '/^image-versions\\.yaml$/',
      ],
      matchStrings: [
        'image:\\s+(?<depName>[^\\n]+)\\n\\s+tag:\\s+(?<currentValue>[^\\n]+)\\n\\s+digest:\\s+(?<currentDigest>sha256:[a-f0-9]+)',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
    },
    {
      customType: 'regex',
      description: 'Track Quadlet container image digests (Project NOMAD stack, Ollama)',
      // Pinned inline in the units rather than in image-versions.yaml: the unit is what
      // ships, so pinning it directly removes the render step and the chance of the two
      // copies disagreeing. Matches `Image=registry/path[:tag]@sha256:...` in any .container file.
      managerFilePatterns: [
        '/^files/system/etc/containers/systemd/users/.+\\.container$/',
      ],
      matchStrings: [
        'Image=(?<depName>[^\\s@:]+)(:(?<currentValue>[^@\\s]+))?@(?<currentDigest>sha256:[a-f0-9]+)',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
    },
    {
      customType: 'regex',
      description: 'Track image dependencies in Justfile',
      managerFilePatterns: [
        '/^Justfile$/',
      ],
      matchStrings: [
        '["\'](?<depName>fedora):(?<currentValue>[^"\']+)["\']',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
    },
    {
      customType: 'regex',
      description: 'Track Cockpit Top (ctop) releases in dx-cockpit module',
      managerFilePatterns: [
        '/^modules/dx-cockpit/dx-cockpit\\.sh$/',
      ],
      matchStrings: [
        'CTOP_VERSION="(?<currentValue>[^"]+)"',
      ],
      depNameTemplate: 'ismetozalp/ctop',
      datasourceTemplate: 'github-releases',
    },
  ],
  packageRules: [
    {
      description: 'Automatically automerge pin and pinDigest updates for all dependencies to maintain stability',
      matchUpdateTypes: [
        'pin',
        'pinDigest',
      ],
      automerge: true,
      ignoreTests: true,
    },
    {
      description: 'Disable automated container updates within GitHub workflows for security/drift prevention',
      enabled: false,
      matchUpdateTypes: [
        'digest',
        'pinDigest',
        'pin',
      ],
      matchDepTypes: [
        'container',
      ],
      matchFileNames: [
        '.github/workflows/**.yaml',
        '.github/workflows/**.yml',
      ],
    },
    {
      description: 'Automerge GitHub Actions digest updates in workflows for security parity',
      matchDatasources: [
        'github-tags',
      ],
      matchFileNames: [
        '.github/workflows/**',
      ],
      matchUpdateTypes: [
        'digest',
        'pinDigest',
      ],
      automerge: true,
      ignoreTests: true,
    },
    {
      description: 'Auto-update and automerge Bazzite-Nvidia base image digest in image-versions.yaml',
      matchFileNames: [
        'image-versions.yaml',
      ],
      matchUpdateTypes: [
        'digest',
        'pinDigest',
      ],
      matchPackageNames: [
        'ghcr.io/ublue-os/bazzite-nvidia',
      ],
      pinDigests: true,
      automerge: true,
      ignoreTests: true,
      commitMessagePrefix: 'chore(deps): ',
    },
    {
      description: 'Pin MySQL to 8.0 LTS branch to prevent breaking InnoDB data migrations for Project NOMAD',
      matchPackageNames: [
        'docker.io/library/mysql',
        'mysql',
      ],
      allowedVersions: '/^8\\.0\\./',
    },
    {
      description: 'Pin Redis to 7.x LTS branch to prevent breaking job queue storage for Project NOMAD',
      matchPackageNames: [
        'docker.io/library/redis',
        'redis',
      ],
      allowedVersions: '/^7\\./',
    },
    {
      description: 'Auto-update and batch Project NOMAD stack image digests in Quadlet units',
      matchFileNames: [
        'files/system/etc/containers/systemd/users/nomad-*.container',
      ],
      matchUpdateTypes: [
        'digest',
        'pinDigest',
      ],
      pinDigests: true,
      groupName: 'Project NOMAD container digests',
      schedule: [
        'before 6am on monday',
      ],
      commitMessagePrefix: 'chore(deps-nomad): ',
    },
    {
      description: 'Auto-update MediaMTX video router container digest in Quadlet unit',
      matchFileNames: [
        'files/system/etc/containers/systemd/users/mediamtx.container',
      ],
      matchUpdateTypes: [
        'digest',
        'pinDigest',
      ],
      pinDigests: true,
      groupName: 'MediaMTX container digest',
      schedule: [
        'before 6am on monday',
      ],
      commitMessagePrefix: 'chore(deps-casting): ',
    },
    {
      description: 'Auto-update RustDesk server container digests in Quadlet units',
      matchFileNames: [
        'files/system/etc/containers/systemd/users/rustdesk-*.container',
      ],
      matchUpdateTypes: [
        'digest',
        'pinDigest',
      ],
      pinDigests: true,
      groupName: 'RustDesk container digests',
      schedule: [
        'before 6am on monday',
      ],
      commitMessagePrefix: 'chore(deps-remote): ',
    },
    {
      description: 'Auto-update ComfyUI AI Studio container digest in Quadlet unit',
      matchFileNames: [
        'files/system/etc/containers/systemd/users/aistudio-visual.container',
      ],
      matchUpdateTypes: [
        'digest',
        'pinDigest',
      ],
      pinDigests: true,
      groupName: 'AI Studio ComfyUI container digest',
      schedule: [
        'before 6am on monday',
      ],
      commitMessagePrefix: 'chore(deps-ai): ',
    },
    {
      description: 'Auto-update and batch ComfyUI visual studio python packages in requirements.txt',
      matchFileNames: [
        'files/system/usr/share/bazzite-dx/aistudio-visual/requirements.txt',
      ],
      groupName: 'ComfyUI visual dependencies',
      commitMessagePrefix: 'chore(deps-visual): ',
    },
    {
      description: 'Disable pinDigests for Fedora builder stage to avoid registry mismatch',
      matchPackageNames: [
        'fedora',
      ],
      pinDigests: false,
    },
    {
      description: 'Auto-update Cockpit Top (ctop) release in dx-cockpit module',
      matchPackageNames: [
        'ismetozalp/ctop',
      ],
      automerge: true,
      commitMessagePrefix: 'chore(deps-cockpit): ',
    },
  ],
}
